<?xml version="1.0" encoding="utf-8"?>
<!-- Artifact configuration "app" of the SignPath project "mira": signing request 1 of windows.yml, on the artifact
     Mira-win-x64-to-sign (Mira's own files of the application folder, and the one-file portable Mira). SignPath
     applies the copy kept in its own web application: paste this one there, and change both together. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <directory path="Mira">
      <pe-file path="Mira.exe">
        <authenticode-sign />
      </pe-file>
      <pe-file path="Mira.dll">
        <authenticode-sign />
      </pe-file>
      <pe-file path="Mira.Core.dll">
        <authenticode-sign />
      </pe-file>
    </directory>
    <directory path="Portable">
      <pe-file path="Mira.exe">
        <authenticode-sign />
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
