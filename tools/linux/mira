#!/bin/sh
# Starts the Linux preview of Mira for Mac from its folder. mpv comes from the system: libmpv.so.2, found here wherever
# the distribution keeps it and handed to Mira (MIRA_LIBMPV), which otherwise looks only in Debian's and Arch's places.
here=$(cd "$(dirname "$0")" && pwd)
if [ -z "${MIRA_LIBMPV:-}" ]; then
  lib=$(/sbin/ldconfig -p 2>/dev/null | awk '/libmpv\.so\.2 .*x86-64/ { print $NF; exit }')
  [ -z "$lib" ] && for p in /usr/lib/x86_64-linux-gnu/libmpv.so.2 /usr/lib64/libmpv.so.2 /usr/lib/libmpv.so.2; do
    [ -f "$p" ] && lib=$p && break
  done
  if [ -z "$lib" ]; then
    echo "libmpv.so.2 not found: install mpv's library, then start Mira again." >&2
    echo "  Debian, Ubuntu, Mint:  sudo apt install libmpv2" >&2
    echo "  Fedora (RPM Fusion):   sudo dnf install mpv-libs" >&2
    echo "  Arch, Manjaro:         sudo pacman -S mpv" >&2
    echo "  openSUSE:              sudo zypper install libmpv2" >&2
    exit 1
  fi
  MIRA_LIBMPV=$lib
  export MIRA_LIBMPV
fi
# The X11 libraries Avalonia loads by name: on a desktop distribution already, not on WSL's Ubuntu or a server.
if ! /sbin/ldconfig -p 2>/dev/null | grep -q 'libICE\.so\.6 .*x86-64' || ! /sbin/ldconfig -p 2>/dev/null | grep -q 'libSM\.so\.6 .*x86-64'; then
  echo "The X11 libraries Mira draws with are missing. On Debian or Ubuntu (WSL too):" >&2
  echo "  sudo apt install libice6 libsm6 libx11-6 libx11-xcb1 libxcursor1 libxrandr2 libxi6 libxext6 libfontconfig1 libgl1 libegl1 libgl1-mesa-dri" >&2
  exit 1
fi
# WSL (Windows 11) tells Linux apps every screen is at scale 1: Mira would be drawn in raw pixels, a third of its size
# on a 4K screen. A Mac's Retina screen is at 2, which WSL gets unless told otherwise.
if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -z "${AVALONIA_GLOBAL_SCALE_FACTOR:-}" ]; then
  AVALONIA_GLOBAL_SCALE_FACTOR=2
  export AVALONIA_GLOBAL_SCALE_FACTOR
fi
exec "$here/Mira" "$@"
