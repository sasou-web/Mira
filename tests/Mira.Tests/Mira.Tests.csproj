<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Mira.Desktop/Mira.Desktop.csproj" /></ItemGroup>
  <!-- The checks free of WPF (tests/Mira.Core.Tests, run on Linux by the CI) run here too, before those of the app. -->
  <ItemGroup><Compile Include="../Mira.Core.Tests/*.cs" Exclude="../Mira.Core.Tests/Program.cs" Link="Portable/%(Filename)%(Extension)" /></ItemGroup>
  <!-- The plugin's playlist rewriting, security policy and web files have no Jellyfin dependency: compiled here to be tested. -->
  <ItemGroup>
    <Compile Include="../../src/Mira.Jellyfin/HlsPlaylists.cs" Link="Plugin/HlsPlaylists.cs" />
    <Compile Include="../../src/Mira.Jellyfin/ContentPolicy.cs" Link="Plugin/ContentPolicy.cs" />
    <Compile Include="../../src/Mira.Jellyfin/IdentifyImages.cs" Link="Plugin/IdentifyImages.cs" />
    <Compile Include="../../src/Mira.Jellyfin/WebFiles.cs" Link="Plugin/WebFiles.cs" />
    <Compile Include="../../src/Mira.Jellyfin/TorLinkRelay.cs" Link="Plugin/TorLinkRelay.cs" />
    <Compile Include="../../src/Mira.Jellyfin/TorLinkRelay.Follows.cs" Link="Plugin/TorLinkRelay.Follows.cs" />
    <Compile Include="../../src/Mira.Jellyfin/GuestRoutes.cs" Link="Plugin/GuestRoutes.cs" />
    <Compile Include="../../src/Mira.Jellyfin/GuestInvites.cs" Link="Plugin/GuestInvites.cs" />
    <Compile Include="../../src/Mira.Jellyfin/PartyPage.cs" Link="Plugin/PartyPage.cs" />
    <Compile Include="../../src/Mira.Jellyfin/TunnelCheck.cs" Link="Plugin/TunnelCheck.cs" />
    <Compile Include="../../src/Mira.Jellyfin/Subtitles/SubtitleSources.cs" Link="Plugin/SubtitleSources.cs" />
    <Compile Include="../../src/Mira.Jellyfin/Subtitles/OpenSubtitlesApi.cs" Link="Plugin/OpenSubtitlesApi.cs" />
    <Compile Include="../../src/Mira.Jellyfin/Subtitles/SubDlApi.cs" Link="Plugin/SubDlApi.cs" />
    <Compile Include="../../src/Mira.Jellyfin/Subtitles/SubtitleSettings.cs" Link="Plugin/SubtitleSettings.cs" />
    <Compile Include="../../src/Mira.Jellyfin/Subtitles/SubtitleQueue.cs" Link="Plugin/SubtitleQueue.cs" />
  </ItemGroup>
  <!-- Nor the Mac app's profile, where its session goes: the keychain is replaced there by a stand-in. -->
  <ItemGroup><Compile Include="../../src/Mira.Mac/Services/Profile.cs" Link="Mac/Profile.cs" /><Compile Include="../../src/Mira.Mac/Services/KeychainVault.cs" Link="Mac/KeychainVault.cs" /></ItemGroup>
</Project>
