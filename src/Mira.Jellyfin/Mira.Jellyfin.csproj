<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mira web, served by Jellyfin itself at /Mira: a Jellyfin plugin with the web app (src/Mira.Web) built in.
    Built against the oldest Jellyfin Mira supports (10.9, .NET 8): the plugin loads on it and on every later version.
  -->
  <PropertyGroup>
    <!-- Not the apps' .NET (Directory.Build.props): Jellyfin 10.9 and 10.10 run on .NET 8 and load nothing newer. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Mira.Jellyfin</AssemblyName>
    <RootNamespace>Mira.Jellyfin</RootNamespace>
    <Version>0.8.7</Version>
    <!-- Only Mira.Jellyfin.dll goes in the plugin: Jellyfin provides its own libraries. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- System.Text.Json 8.0.4, through Jellyfin.Controller: compiled against only, never shipped (runtime assets are
         excluded above); Jellyfin runs the plugin with its own, up to date. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-8g4q-xg66-9fp4" />
  </ItemGroup>
  <ItemGroup>
    <!-- What a search or a download sent from Mira web may be, and what Mira for Windows exchanges with the relay: shared with it. -->
    <Compile Include="../Mira.Core/TorLink/RemoteDownloads.cs" Link="RemoteDownloads.cs" />
    <Compile Include="../Mira.Core/TorLink/RemoteProtocol.cs" Link="RemoteProtocol.cs" />
    <Compile Include="../Mira.Core/TorLink/FollowSchedule.cs" Link="Core/FollowSchedule.cs" />
    <!-- « Sous-titres automatiques »: the scoring and file reading of Mira.Core, and what they need (release names, texts). -->
    <Compile Include="../Mira.Core/GlobalUsings.cs" Link="Core/GlobalUsings.cs" />
    <Compile Include="../Mira.Core/Lang.cs" Link="Core/Lang.cs" />
    <Compile Include="../Mira.Core/Subtitles/SubtitleText.cs" Link="Core/SubtitleText.cs" />
    <Compile Include="../Mira.Core/Subtitles/SubtitleMatch.cs" Link="Core/SubtitleMatch.cs" />
    <Compile Include="../Mira.Core/Subtitles/SubtitleSync.cs" Link="Core/SubtitleSync.cs" />
    <Compile Include="../Mira.Core/TorLink/ReleaseName.cs" Link="Core/ReleaseName.cs" />
    <Compile Include="../Mira.Core/TorLink/ReleaseRanking.cs" Link="Core/ReleaseRanking.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Mira.Web/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Each version's main points (Mira.Core): the phone shows those of a new Mira web once, « Nouveau dans Mira ». -->
    <EmbeddedResource Include="../Mira.Core/WhatsNew.json" LogicalName="web/whats-new.json" />
  </ItemGroup>
</Project>
