        }
      }
    },
    "Automatic subtitles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-titres automatiques"
          }
        }
      }
    },
    "Automatic: the file as it is at home; away from home, what your connection to Jellyfin allows. Below the file’s quality, Jellyfin converts it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : le fichier tel quel à la maison ; ailleurs, ce que permet ta connexion à Jellyfin. En dessous de la qualité du fichier, Jellyfin le convertit."
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ailleurs qu’à la maison"
          }
        }
      }
    },
    "Away from home, Mira reaches Jellyfin again once you sign in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ailleurs, Mira rejoindra Jellyfin quand tu te reconnecteras."
          }
        }
      }
    },
    "Away from home: Built-in Tailscale": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ailleurs : Tailscale intégré"
          }
        }
      }
    },
    "Back to the player": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir au lecteur"
          }
        }
      }
    },
