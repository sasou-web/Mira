      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic: the file as it is at home; away from home, what your connection to Jellyfin allows. Below the file’s quality, Jellyfin converts it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : le fichier tel quel à la maison ; ailleurs, ce que permet ta connexion à Jellyfin. En dessous de la qualité du fichier, Jellyfin le convertit."
          }
        }
      }
    },
