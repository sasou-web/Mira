    },
    "This iPhone isn’t connected to the Internet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n’est pas connecté à Internet."
          }
        }
      }
    },
    "This iPhone’s sign-in to Tailscale expires on %@: sign in again then, or turn off key expiry in Tailscale’s admin console (the ⋯ menu of “%@”, “Disable key expiry”).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de cet iPhone à Tailscale expire le %1$@ : reconnecte-le alors, ou coupe cette expiration dans la console de Tailscale (menu ⋯ de « %2$@ », « Disable key expiry »)."
          }
        }
      }
    },
    "This iPhone’s sign-in to Tailscale has expired. Your password stays on Tailscale’s page: Mira never sees it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de cet iPhone à Tailscale a expiré. Ton mot de passe reste sur la page de Tailscale : Mira ne le voit jamais."
          }
        }
      }
    },
    "This iPhone’s sign-in to Tailscale has expired: sign in again in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion de cet iPhone à Tailscale a expiré : reconnecte-toi dans les Réglages."
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mois-ci"
          }
        }
      }
    },
    "This server’s HTTPS certificate isn’t recognized. If this server is at your home, type its full address with http://, for example http://192.168.1.20:8096.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat HTTPS de ce serveur n’est pas reconnu. Si ce serveur est chez toi, tape son adresse complète en http://, par exemple http://192.168.1.20:8096."
          }
        }
      }
    },
    "This title is no longer on Jellyfin.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce titre n’est plus sur Jellyfin."
          }
        }
      }
    },
