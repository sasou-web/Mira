    },
    "The season is on this iPhone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saison est sur cet iPhone"
          }
        }
      }
    },
    "The server isn’t answering. Check the address and that Jellyfin is running.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne répond pas. Vérifie l’adresse et que Jellyfin est bien lancé."
          }
