          }
        }
      }
    },
    "The player refused this video, even fully converted by Jellyfin.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur refuse cette vidéo, même entièrement convertie par Jellyfin."
          }
        }
      }
    },
    "The player refused this video, even fully converted by Jellyfin. (%@)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur refuse cette vidéo, même entièrement convertie par Jellyfin. (%@)"
          }
        }
      }
    },
    "The server isn’t answering. Check the address and that Jellyfin is running.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne répond pas. Vérifie l’adresse et que Jellyfin est bien lancé."
          }
        }
      }
    },
    "This address answers, but it isn’t a Jellyfin server. Check the port (8096 by default).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse répond, mais ce n’est pas un serveur Jellyfin. Vérifie le port (8096 par défaut)."
          }
        }
      }
    },
    "This address goes over the Internet with http://: nothing is encrypted, and anyone along the way could read your password. Use its https:// address or Tailscale instead, or tap “Sign in anyway”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse passe par Internet, en http:// : rien n’y est chiffré, et ton mot de passe y passerait lisible par n’importe qui sur le trajet. Utilise plutôt son adresse https:// ou Tailscale, ou touche « Se connecter quand même »."
          }
        }
      }
    },
    "This server’s HTTPS certificate isn’t recognized. If this server is at your home, type its full address with http://, for example http://192.168.1.20:8096.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat HTTPS de ce serveur n’est pas reconnu. Si ce serveur est chez toi, tape son adresse complète en http://, par exemple http://192.168.1.20:8096."
          }
        }
      }
    },
