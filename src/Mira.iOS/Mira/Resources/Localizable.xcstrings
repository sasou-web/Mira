    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic subtitles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-titres automatiques"
          }
        }
      }
    },
    "Automatic: the file as it is at home; away from home, what your connection to Jellyfin allows. Below the file’s quality, Jellyfin converts it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : le fichier tel quel à la maison ; ailleurs, ce que permet ta connexion à Jellyfin. En dessous de la qualité du fichier, Jellyfin le convertit."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Can’t play this title": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture impossible"
          }
        }
      }
    },
    "Can’t reach Jellyfin. At home, check the Wi-Fi; away from home, turn on Tailscale.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin est injoignable. À la maison, vérifie le Wi-Fi ; ailleurs, active Tailscale."
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer"
          }
        }
      }
    },
    "Check the spelling, or try another word of the title.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie l’orthographe, ou essaie un autre mot du titre."
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer"
          }
        }
      }
    },
    "Code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code"
          }
        }
      }
    },
    "Connection to the server lost. Playback resumes as soon as it answers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion au serveur perdue. La lecture reprend dès qu’il répond."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
