        }
      }
    },
    "The server PC didn’t answer in time. Check that Mira is open there, then search again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PC serveur n’a pas répondu à temps. Vérifie que Mira y est ouvert, puis relance la recherche."
