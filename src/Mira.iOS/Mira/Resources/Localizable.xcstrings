    "TorLink can’t write to its folder": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink ne peut pas écrire dans son dossier"
          }
        }
      }
    },
    "TorLink downloads on the PC that runs Jellyfin, without you having to touch it, then Mira adds the title to your library. Mira must be open there, even minimized. Only Jellyfin administrators and the accounts they let download see this screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink télécharge sur le PC où tourne Jellyfin, sans que tu aies à y toucher, puis Mira range le titre dans ta bibliothèque. Mira doit y être ouvert, même réduit. Seuls les administrateurs de Jellyfin et les comptes qu’ils laissent télécharger voient cet écran."
          }
        }
      }
    },
    "TorLink refused this download.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink a refusé ce téléchargement."
          }
        }
      }
    },
