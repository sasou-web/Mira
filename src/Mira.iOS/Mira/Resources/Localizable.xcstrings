        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander si tu regardes toujours"
          }
        }
      }
    },
    "After 3 episodes in a row without touching anything, Mira stops and asks before the next one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après 3 épisodes de suite sans rien toucher, Mira s’arrête et demande avant le suivant."
