    "This search was lost. Try it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette recherche a été perdue : relance-la."
          }
        }
      }
    },
    "TorLink can’t write to its folder": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink ne peut pas écrire dans son dossier"
          }
        }
      }
    },
    "TorLink downloads on the PC that runs Jellyfin, without you having to touch it, then Mira adds the title to your library. Mira must be open there, even minimized. Only Jellyfin administrator accounts see this screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink télécharge sur le PC où tourne Jellyfin, sans que tu aies à y toucher, puis Mira range le titre dans ta bibliothèque. Mira doit y être ouvert, même réduit. Seuls les comptes administrateurs de Jellyfin voient cet écran."
          }
        }
      }
    },
    "TorLink refused this download.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink a refusé ce téléchargement."
          }
        }
      }
    },
    "TorLink stops it and deletes what it has already downloaded on the server PC.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TorLink l’arrête et supprime ce qu’il en a déjà sur le PC serveur."
          }
        }
      }
    },
