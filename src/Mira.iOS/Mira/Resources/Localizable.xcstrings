      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la maison (direct)"
          }
        }
      }
    },
    "At home, the address of the PC with Jellyfin. Away from home, its Tailscale address, with Built-in Tailscale or the Tailscale app on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la maison, l’adresse du PC où tourne Jellyfin. Ailleurs, son adresse Tailscale, avec Tailscale intégré ou l’app Tailscale activés."
          }
        }
      }
    },
