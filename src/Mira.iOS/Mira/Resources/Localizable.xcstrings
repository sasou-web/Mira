          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin"
          }
        }
      }
    },
    "Jellyfin answered with an error (%lld). Try again in a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin a répondu par une erreur (%lld). Réessaie dans un instant."
          }
        }
      }
    },
    "Jellyfin doesn’t allow this account to do that.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne permet pas ça à ce compte."
          }
        }
      }
    },
    "Jellyfin doesn’t allow this account to play this title.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin n’autorise pas ce compte à lire ce titre."
          }
        }
      }
    },
    "Jellyfin has no stream this iPhone can play for this title.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne propose aucun flux lisible par cet iPhone pour ce titre."
          }
        }
      }
    },
    "Jellyfin isn’t answering": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne répond pas"
          }
        }
      }
    },
    "Jellyfin refused to play this title (%@).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin a refusé de lire ce titre (%@)."
