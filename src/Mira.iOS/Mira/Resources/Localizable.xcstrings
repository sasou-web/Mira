      }
    },
    "Part of the library": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de la bibliothèque"
          }
        }
      }
    },
    "Profiles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profils"
          }
        }
      }
    },
    "Ready: the home’s devices reach only Jellyfin on your Tailscale network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt : les appareils du foyer n’atteignent que Jellyfin sur ton réseau Tailscale."
          }
        }
      }
    },
    "Remove PIN": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer le code"
          }
        }
