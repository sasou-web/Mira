    "Address": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse"
          }
        }
      }
    },
    "At home, the address of the PC with Jellyfin. Away from home, its Tailscale address, with Tailscale on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la maison, l’adresse du PC où tourne Jellyfin. Ailleurs, son adresse Tailscale, Tailscale activé."
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic: the file as it is at home; away from home, what your connection to Jellyfin allows. Below the file’s quality, Jellyfin converts it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : le fichier tel quel à la maison ; ailleurs, ce que permet ta connexion à Jellyfin. En dessous de la qualité du fichier, Jellyfin le convertit."
          }
        }
      }
    },
    "Can’t play this title": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture impossible"
          }
        }
      }
    },
    "Can’t reach Jellyfin. At home, check the Wi-Fi; away from home, turn on Tailscale.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin est injoignable. À la maison, vérifie le Wi-Fi ; ailleurs, active Tailscale."
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
    "Continue watching": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer à regarder"
          }
        }
      }
    },
    "E%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "É%@"
          }
        }
      },
      "comment": "An episode's number: É5 in French"
    },
    "Enter an http:// or https:// address, without credentials in it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis une adresse http:// ou https://, sans identifiants dans l’adresse."
          }
        }
      }
    },
    "Enter your Jellyfin server’s address, for example 192.168.1.20.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l’adresse de ton serveur Jellyfin, par exemple 192.168.1.20."
          }
        }
      }
    },
    "external file": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "fichier externe"
          }
        }
