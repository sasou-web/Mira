    "Authorizing…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation…"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic subtitles": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-titres automatiques"
          }
        }
      }
    },
    "Automatic: the file as it is at home; away from home, what your connection to Jellyfin allows. Below the file’s quality, Jellyfin converts it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique : le fichier tel quel à la maison ; ailleurs, ce que permet ta connexion à Jellyfin. En dessous de la qualité du fichier, Jellyfin le convertit."
          }
        }
      }
    },
    "Away from home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ailleurs qu’à la maison"
          }
        }
      }
    },
    "Away from home, Mira reaches Jellyfin again once you sign in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ailleurs, Mira rejoindra Jellyfin quand tu te reconnecteras."
          }
        }
      }
    },
    "Away from home: Built-in Tailscale": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ailleurs : Tailscale intégré"
          }
        }
      }
    },
    "Built-in Tailscale": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré"
          }
        }
      }
    },
    "Built-in Tailscale can’t reach Tailscale. Check this iPhone’s connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré ne joint pas Tailscale. Vérifie la connexion de cet iPhone."
          }
        }
      }
    },
    "Built-in Tailscale couldn’t start": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré n’a pas pu démarrer"
          }
        }
      }
    },
    "Built-in Tailscale couldn’t start. Close Mira and open it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré n’a pas pu démarrer. Ferme Mira et rouvre-la."
          }
        }
      }
    },
    "Built-in Tailscale is signed out: sign in again in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré est déconnecté : reconnecte-toi dans les Réglages."
          }
        }
      }
    },
    "Built-in Tailscale is waiting for this iPhone to be approved in Tailscale’s admin console.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré attend que cet iPhone soit approuvé dans la console d’administration de Tailscale."
          }
        }
      }
    },
    "Built-in Tailscale only reaches the devices of your Tailscale network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale intégré ne joint que les appareils de ton réseau Tailscale."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Can’t play this title": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture impossible"
          }
        }
      }
    },
    "Can’t reach Jellyfin. At home, check the Wi-Fi; away from home, turn on Tailscale.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin est injoignable. À la maison, vérifie le Wi-Fi ; ailleurs, active Tailscale."
          }
        }
      }
    },
    "Can’t reach Jellyfin. Away from home, turn on Built-in Tailscale in Settings, or the Tailscale app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin est injoignable. Ailleurs, active Tailscale intégré dans les Réglages, ou l’app Tailscale."
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer"
          }
        }
      }
    },
