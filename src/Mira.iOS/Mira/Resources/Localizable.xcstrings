    "Jellyfin": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin"
          }
        }
      }
    },
    "Jellyfin answered with an error (%lld). Try again in a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin a répondu par une erreur (%lld). Réessaie dans un instant."
          }
        }
      }
    },
    "Jellyfin answers, but the video no longer reaches this iPhone. Try again, or choose a lower quality if the connection is slow.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin répond, mais la vidéo n’arrive plus jusqu’à cet iPhone. Réessaie, ou choisis une qualité plus basse si la connexion est lente."
          }
        }
      }
    },
    "Jellyfin didn’t answer. Try again in a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin n’a pas répondu. Réessaie dans un instant."
          }
        }
      }
    },
    "Jellyfin doesn’t allow this account to do that.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne permet pas ça à ce compte."
          }
        }
      }
    },
    "Jellyfin doesn’t allow this account to play this title.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin n’autorise pas ce compte à lire ce titre."
          }
        }
      }
    },
    "Jellyfin doesn’t allow this account to put a title on for the group.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne permet pas à ce compte de lancer un titre pour le groupe."
          }
        }
      }
    },
    "Jellyfin doesn’t allow this account to watch together (SyncPlay).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne permet pas à ce compte de regarder ensemble (SyncPlay)."
          }
        }
      }
    },
    "Jellyfin has no stream this iPhone can play for this title.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jellyfin ne propose aucun flux lisible par cet iPhone pour ce titre."
          }
        }
