    "the server PC’s disk is full": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "plus de place sur le disque du PC serveur"
          }
        }
      }
    },
    "Open this link to watch with me on Mira, with no account to make.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre ce lien pour regarder avec moi sur Mira, sans compte à créer."
          }
        }
      }
    },
    "Profiles, titles to fix, automatic subtitles and your party’s guests are in Mira for Windows and Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils, les titres à corriger, les sous-titres automatiques et les invités de ta party sont dans Mira pour Windows et Mac."
          }
        }
      }
    },
    "Mira knows %@’s addresses now, at home and away.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira connaît maintenant les adresses de %@, chez toi et ailleurs."
          }
        }
      }
    },
    "You’re signed in to %@. To use another server, sign out in Settings first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es connecté à %@. Pour un autre serveur, déconnecte-toi d’abord dans Réglages."
          }
        }
      }
    },
    "Mira can’t reach %@ right now. At home, join your Wi-Fi; away from home, turn on Built-in Tailscale below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira ne joint pas %@ pour l’instant. Chez toi, connecte-toi à ton Wi-Fi ; ailleurs, active Tailscale intégré plus bas."
          }
        }
      }
    },
    "Mobile data · %@ Mb/s": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données mobiles · %@ Mb/s"
          }
        }
      }
    },
    "Mobile data": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données mobiles"
          }
        }
      }
    },
    "On cellular or a personal hotspot. Data saver uses about 0.9 GB an hour, and stays on with Low Data Mode.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En 4G ou en partage de connexion. L’économie de données consomme environ 0,9 Go par heure, et reste active en mode Données réduites."
          }
        }
      }
    },
    "Data saver · 2 Mb/s": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Économie de données · 2 Mb/s"
          }
        }
      }
    },
    "Standard · 6 Mb/s": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale · 6 Mb/s"
          }
        }
      }
    },
    "Are you still watching?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regardes toujours ?"
          }
        }
      }
    },
    "Mira stopped after 3 episodes in a row with nothing touched. Up next: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira s’est arrêté après 3 épisodes de suite sans que rien ne soit touché. À suivre : %@"
          }
        }
      }
    },
    "Keep watching": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
    "Ask if you’re still watching": {
