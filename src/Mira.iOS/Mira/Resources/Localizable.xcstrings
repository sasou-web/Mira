      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à Tailscale…"
          }
        }
      }
    },
    "Connection to the server lost. Playback resumes as soon as it answers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion au serveur perdue. La lecture reprend dès qu’il répond."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
