      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "forcés"
          }
        }
      }
    },
    "From Jellyfin: each film or episode watched to the end counts once, at its last play, on all your devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après Jellyfin : chaque film ou épisode vu jusqu’au bout compte une fois, à sa dernière lecture, sur tous tes appareils."
          }
        }
      }
    },
