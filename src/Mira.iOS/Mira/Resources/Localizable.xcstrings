      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur d’Apple"
          }
        }
      }
    },
    "At home, the address of the PC with Jellyfin. Away from home, its Tailscale address, with Tailscale on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la maison, l’adresse du PC où tourne Jellyfin. Ailleurs, son adresse Tailscale, Tailscale activé."
          }
        }
      }
    },
    "Audio": {
      "localizations": {
