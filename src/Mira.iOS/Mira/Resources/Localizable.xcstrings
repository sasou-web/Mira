    "Their order, and which show, on this iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur ordre, et celles qui s’affichent, sur cet iPhone."
          }
        }
      }
    },
    "Then sign in to Tailscale, once, with your Tailscale account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis connecte-toi à Tailscale, une seule fois, avec ton compte Tailscale."
          }
        }
      }
    },
    "These connections leave from Jellyfin’s PC, never from this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces connexions partent du PC de Jellyfin, jamais de cet appareil."
          }
        }
      }
    },
    "TheTVDB, through its official Jellyfin extension.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TheTVDB, par son extension officielle de Jellyfin."
          }
        }
      }
    },
    "This address answers, but it isn’t a Jellyfin server. Check the port (8096 by default).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse répond, mais ce n’est pas un serveur Jellyfin. Vérifie le port (8096 par défaut)."
          }
        }
      }
    },
    "This address goes over the Internet with http://: nothing is encrypted, and anyone along the way could read your password. Use its https:// address or Tailscale instead, or tap “Sign in anyway”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse passe par Internet, en http:// : rien n’y est chiffré, et ton mot de passe y passerait lisible par n’importe qui sur le trajet. Utilise plutôt son adresse https:// ou Tailscale, ou touche « Se connecter quand même »."
          }
        }
      }
    },
    "This code expired. Ask for a new one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a expiré. Demandes-en un nouveau."
          }
        }
      }
    },
    "This group no longer exists.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe n’existe plus."
          }
        }
      }
    },
    "This iPhone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone"
          }
        }
      }
    },
    "This iPhone has no connection to Tailscale right now. Check its connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne joint pas Tailscale pour l’instant. Vérifie sa connexion."
