    "10 seconds into the end credits when they are marked, otherwise at the end of the episode. A button offers it sooner.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 secondes après le début du générique de fin quand il est repéré, sinon à la fin de l’épisode. Un bouton le propose plus tôt."
          }
        }
      }
    },
