<Project Sdk="Microsoft.NET.Sdk">
  <!-- libmpv's functions are called through function pointers (MpvClient). Product "Mira": SignPath signs only files whose
       product name is Mira (installer/signpath/app.xml); the default would be the assembly's name. -->
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Product>Mira</Product></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Reads the .7z archive of the libmpv build Mira can install on request (LZMA2 + BCJ2). -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- The QR code of « Mira sur ton iPhone » (PhoneLink): a port of Nayuki's reference encoder, MIT, no dependency. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The main points of each version: the "what's new" screen and the release page on GitHub. -->
    <EmbeddedResource Include="WhatsNew.json" LogicalName="Mira.Core.WhatsNew.json" />
    <!-- The project npm installs TorLink from: every dependency at a reviewed version, each archive checked by its sha512. -->
    <EmbeddedResource Include="TorLink/Lock/package.json" LogicalName="Mira.Core.TorLink.package.json" />
    <EmbeddedResource Include="TorLink/Lock/package-lock.json" LogicalName="Mira.Core.TorLink.package-lock.json" />
  </ItemGroup>
</Project>
