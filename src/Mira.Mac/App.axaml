<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mira.Mac.App" RequestedThemeVariant="Dark" Name="Mira">
  <Application.Resources>
    <!-- The Windows app's cinema palette: true black (OLED), neutral greys, a white accent. -->
    <SolidColorBrush x:Key="Bg" Color="#000000"/>
    <SolidColorBrush x:Key="Surface" Color="#111111"/>
    <SolidColorBrush x:Key="Raised" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Line" Color="#272727"/>
    <SolidColorBrush x:Key="Muted" Color="#A2A2A6"/>
    <SolidColorBrush x:Key="Faint" Color="#8A8A90"/>
    <SolidColorBrush x:Key="Ink" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="Accent" Color="#F5F5F7"/>
    <!-- The menus, « Écrin » as on Windows (Themes/Cinema.xaml): their edge, a cell chosen, its edge, the lines between their
         parts, the sunk track of a slider of choices, the body ink of their rows. -->
    <SolidColorBrush x:Key="MenuLine" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Raised2" Color="#242424"/>
    <SolidColorBrush x:Key="LineStrong" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="Rule" Color="#222222"/>
    <SolidColorBrush x:Key="Inset" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TextBody" Color="#E0E0E0"/>
    <FontFamily x:Key="AppFont">avares://Mira/Assets/Fonts#Nunito</FontFamily>
    <!-- Switches: white when on, so their knob is dark to stay visible. -->
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0B0B0B"/>
  </Application.Resources>
  <!-- The Mira menu of the menu bar (macOS adds Hide and Quit itself), its headers in Mira's language by App.NameMenu. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="À propos de Mira" Click="About_Click"/>
      <NativeMenuItemSeparator/>
      <NativeMenuItem Header="Réglages…" Gesture="Meta+OemComma" Click="Settings_Click"/>
      <NativeMenuItem Header="Rechercher une mise à jour…" Click="Updates_Click"/>
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#F5F5F7" AltHigh="#000000" RegionColor="#000000" BaseHigh="#F4F4F5" ChromeMediumLow="#151515" ChromeMedium="#1C1C1C" ChromeLow="#1C1C1C"/>
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="44"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
    <Style Selector="TextBlock.faint"><Setter Property="Foreground" Value="{StaticResource Faint}"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Faint}"/><Setter Property="LetterSpacing" Value="0.6"/></Style>

    <!-- « Mode canapé » draws its own ring (MainWindow.Couch.cs): Avalonia's focus adorner ignores the pages' zoom and lands elsewhere. -->
    <Style Selector="Window.couch :is(Control)"><Setter Property="FocusAdorner" Value="{x:Null}"/></Style>
    <!-- Buttons: drawn by Mira, with a gentle hover wash in their own ink. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#212121"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- Still buttons, a static hover (ogsas, 2026-11-12): no colour transition, and not the Fluent theme's shrink on press. -->
      <Setter Property="Transitions"><Transitions/></Setter>
    </Style>
    <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="none"/></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#2D2D2D"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#363636"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="0.4"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#F5F5F7"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#DADADF"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <!-- Menus: the Windows app's (Menu, Line), rounded, with room around each line. -->
    <!-- « Écrin » (mockup A chosen by ogsas, 2026-11-14): a solid window, its 1 px edge, 14 px corners; rows of 38 px whose
         hover is raised, never animated; the lines between their parts. -->
    <Style Selector="ContextMenu"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource MenuLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="6"/><Setter Property="MinWidth" Value="232"/></Style>
    <Style Selector="ContextMenu MenuItem"><Setter Property="Padding" Value="12,0,16,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{StaticResource Raised}"/></Style>
    <Style Selector="ContextMenu MenuItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{StaticResource Raised}"/></Style>
    <Style Selector="ContextMenu MenuItem:pressed /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{StaticResource Raised2}"/></Style>
    <Style Selector="ContextMenu Separator"><Setter Property="Background" Value="{StaticResource Rule}"/><Setter Property="Margin" Value="10,6"/><Setter Property="Height" Value="1"/></Style>
    <Style Selector="ToolTip"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource MenuLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1F1F1F"/></Style>
    <!-- A choice that is on (« Dans tes favoris », « Vu », « Ensemble · 2 personnes »): white, the size of the buttons beside it. -->
    <Style Selector="Button.on"><Setter Property="Background" Value="#F5F5F7"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <!-- A title page's buttons beside Lecture: the same rounded square on or off, only their glyph changes (StateIcon), at once. -->
    <Style Selector="Button.on:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.on:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#DADADF"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.icon"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="20"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#26FFFFFF"/></Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.rail"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="48"/><Setter Property="Height" Value="46"/><Setter Property="CornerRadius" Value="15"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#B6B6BD"/></Style>
    <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1B1B1B"/><Setter Property="Foreground" Value="#F4F4F5"/></Style>
    <Style Selector="Button.rail.active"><Setter Property="Background" Value="#F5F5F7"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.rail.active:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.chip"><Setter Property="Background" Value="#1C1C1C"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="CornerRadius" Value="16"/></Style>
    <Style Selector="Button.chip.on"><Setter Property="Background" Value="#F5F5F7"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#0B0B0B"/></Style>
    <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="15"/></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="TextBlock.TextDecorations" Value="Underline"/></Style>
    <Style Selector="Button.card"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.row"><Setter Property="Background" Value="#101010"/><Setter Property="Padding" Value="14"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#191919"/></Style>
    <!-- The player's title and episode line (PlayerPage.Heading): plain text that opens its page, underlined under the pointer. -->
    <Style Selector="Button.heading"><Setter Property="ToolTip.ServiceEnabled" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.heading:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.heading:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.heading:pointerover TextBlock, Button.heading:focus-visible TextBlock"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.heading:pointerover TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style>
    <Style Selector="Button.player"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="CornerRadius" Value="22"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="White"/></Style>
    <!-- Over the picture: no disc under the glyph, which alone lights up under the pointer, as on Windows; no tooltip either. -->
    <Style Selector="Button.player"><Setter Property="Opacity" Value="0.8"/><Setter Property="ToolTip.ServiceEnabled" Value="False"/></Style>
    <Style Selector="Button.player:pointerover, Button.player:focus-visible"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Button.player:pressed"><Setter Property="Opacity" Value="0.6"/></Style>
    <Style Selector="Button.player:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.player:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.player:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Opacity" Value="0.4"/></Style>
    <!-- The player's menus, as on Windows: a dark rounded card, its sections in one column, choices as chips. -->
    <Style Selector="FlyoutPresenter"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource MenuLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="8"/><Setter Property="MaxWidth" Value="900"/><Setter Property="MaxHeight" Value="640"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <!-- A cell of a slider of choices (quality, sleep timer, languages): the chosen one raised with its edge, in bold. -->
    <Style Selector="Button.menuchip"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="0,6"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="CornerRadius" Value="8"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.menuchip:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style Selector="Button.menuchip.on"><Setter Property="Background" Value="{StaticResource Raised2}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Button.menuchip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Raised2}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <!-- « − 0.0 s + » of a delay, and a button with its own edge (« Leave », « Repair »). -->
    <Style Selector="Button.menuchip.step"><Setter Property="Width" Value="30"/><Setter Property="MinHeight" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/></Style>
    <Style Selector="Button.menuchip.step.value"><Setter Property="Width" Value="56"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style Selector="Button.menuchip.edged"><Setter Property="BorderBrush" Value="{StaticResource MenuLine}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="MinHeight" Value="32"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
    <!-- A row of a menu (a track, an action, an episode): flat, raised under the pointer and when chosen. -->
    <Style Selector="Button.menurow"><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.menurow.on"><Setter Property="Background" Value="{StaticResource Raised}"/></Style>
    <Style Selector="Button.menurow:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Raised}"/></Style>
    <Style Selector="Button.menurow:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Raised2}"/></Style>
    <Style Selector="Button.pill"><Setter Property="Background" Value="#E0161616"/><Setter Property="BorderBrush" Value="#5CFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,12,17,12"/><Setter Property="CornerRadius" Value="9"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#F0212121"/><Setter Property="Foreground" Value="White"/></Style>

    <Style Selector="TextBox">
      <!-- Selected text: macOS's blue under white ink (the theme's accent, white, hid the text it selected). -->
      <Setter Property="SelectionBrush" Value="#3F6FB5"/>
      <Setter Property="SelectionForegroundBrush" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#171717"/>
      <Setter Property="BorderBrush" Value="#2B2B2B"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <!-- Being typed in: flat, one step lighter, a quiet grey edge (FieldFocus of Windows, field-focus of Mira web). -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#1C1C1C"/><Setter Property="BorderBrush" Value="#6A6A70"/></Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="#1B1B1B"/></Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#1C1C1C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinWidth" Value="150"/>
    </Style>
    <!-- Its list, « Écrin »: the menus' window, the item chosen raised, in bold. -->
    <Style Selector="ComboBox /template/ Border#PopupBorder"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource MenuLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="6"/></Style>
    <Style Selector="ComboBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/></Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style Selector="ComboBoxItem:selected"><Setter Property="FontWeight" Value="Bold"/></Style>
    <!-- No vertical bar, as on Windows: the wheel, the touchpad and the keys scroll a page. Hidden, not the bar's
         IsVisible: the bar sets that itself from its Visibility, over any style. -->
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Hidden"/></Style>
  </Application.Styles>
</Application>
