<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mira for macOS (Apple Silicon): the same Jellyfin client and mpv player as the Windows app, with an Avalonia
       interface. Mira.Core is shared; nothing here is built into the Windows app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Mira</AssemblyName>
    <RootNamespace>Mira.Mac</RootNamespace>
    <!-- Release builds take the version from the release tag (see .github/workflows/mac.yml). -->
    <Version>0.7.1</Version>
    <Product>Mira</Product>
    <Description>Ta bibliothèque Jellyfin avec mpv intégré</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <ProjectReference Include="../Mira.Core/Mira.Core.csproj" />
    <!-- The Windows app's typeface and mark, shared rather than copied. -->
    <AvaloniaResource Include="../Mira.Desktop/Assets/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../Mira.Desktop/Assets/mira.png" Link="Assets/mira.png" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
