<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:Mira.Desktop.Views"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" mc:Ignorable="po">
  <!-- Mira's palette, the one source of the window's colours: the names and the neutrals of Mira web (app.css) and of
       the Mac (App.axaml). Frozen brushes are shared and never changed in place; Muted, Faint and FocusRing are not
       frozen: high contrast replaces them (MainWindow.Accessibility), so they are read as DynamicResource. -->
  <!-- Surfaces, darkest first: the window, panels and rows, fields and lists, raised tiles, buttons, lines. -->
  <SolidColorBrush x:Key="Bg" Color="#080808"/>
  <SolidColorBrush x:Key="Surface" Color="#111111"/>
  <SolidColorBrush x:Key="Field" Color="#121212" po:Freeze="True"/>
  <SolidColorBrush x:Key="Raised" Color="#1C1C1C" po:Freeze="True"/>
  <SolidColorBrush x:Key="Raised2" Color="#242424" po:Freeze="True"/>
  <SolidColorBrush x:Key="Line" Color="#2A2A2A" po:Freeze="True"/>
  <SolidColorBrush x:Key="LineStrong" Color="#3F3F3F" po:Freeze="True"/>
  <!-- Ink, lightest first. Every text one reads at 4.5:1 or more on Mira's surfaces (AccessibilityTests); Dim is for
       glyphs and dots only, never for text. -->
  <SolidColorBrush x:Key="Text" Color="#F5F5F5" po:Freeze="True"/>
  <SolidColorBrush x:Key="TextBody" Color="#E0E0E0" po:Freeze="True"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#C7C7C7" po:Freeze="True"/>
  <SolidColorBrush x:Key="TextTertiary" Color="#B9B9B9" po:Freeze="True"/>
  <SolidColorBrush x:Key="Muted" Color="#A3A3A3"/>
  <!-- Small labels and hints: the dimmest text that still reads at 4.5:1 on Mira's surfaces (5.5:1 on #111111). -->
  <SolidColorBrush x:Key="Faint" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="Dim" Color="#757575" po:Freeze="True"/>
  <!-- The ink of a light button (Accent behind it). -->
  <SolidColorBrush x:Key="OnAccent" Color="#121212" po:Freeze="True"/>
  <!-- States: done, waiting or offline, failed. The warning has its own text, surface and line for the offline badge. -->
  <SolidColorBrush x:Key="Success" Color="#86C6A2" po:Freeze="True"/>
  <SolidColorBrush x:Key="Warning" Color="#D5B787" po:Freeze="True"/>
  <SolidColorBrush x:Key="WarningText" Color="#E9DCC3" po:Freeze="True"/>
  <SolidColorBrush x:Key="WarningSurface" Color="#F21C1A16" po:Freeze="True"/>
  <SolidColorBrush x:Key="WarningLine" Color="#4D8C7650" po:Freeze="True"/>
  <SolidColorBrush x:Key="Danger" Color="#F3AD99" po:Freeze="True"/>
  <!-- The window's close button, Windows' own red. -->
  <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" po:Freeze="True"/>
  <SolidColorBrush x:Key="ClosePressed" Color="#B0271A" po:Freeze="True"/>
  <!-- See-through layers: lines and washes of white over video or artwork, menus and messages, sheets over the page. -->
  <SolidColorBrush x:Key="Hairline" Color="#30FFFFFF" po:Freeze="True"/>
  <SolidColorBrush x:Key="HairlineStrong" Color="#5CFFFFFF" po:Freeze="True"/>
  <SolidColorBrush x:Key="Wash" Color="#24FFFFFF" po:Freeze="True"/>
  <SolidColorBrush x:Key="Menu" Color="#F5151515" po:Freeze="True"/>
  <SolidColorBrush x:Key="Toast" Color="#F0242424" po:Freeze="True"/>
  <SolidColorBrush x:Key="Pill" Color="#E0161616" po:Freeze="True"/>
  <SolidColorBrush x:Key="Sheet" Color="#F0111111" po:Freeze="True"/>
  <SolidColorBrush x:Key="Scrim" Color="#F4080808" po:Freeze="True"/>
  <!-- Keyboard focus ring; Windows' highlight colour in high contrast (MainWindow). -->
  <SolidColorBrush x:Key="FocusRing" Color="#F5F5F5"/>
  <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>
  <SolidColorBrush x:Key="Accent" Color="#F5F5F5"/>
  <!-- Text in Ideal mode, grayscale: Nunito carries no hinting, and Display mode (GDI-classic metrics, no vertical
       anti-aliasing) drew its curves in steps, worst on titles. Popups are windows of their own: same setters. -->
  <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/></Style>
  <!-- Shown only when focus arrives from the keyboard; mouse clicks no longer leave a white outline. -->
  <Style x:Key="KeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><v:Squircle x:Name="Ring" Margin="-3" CornerRadius="9" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2" SnapsToDevicePixels="True"/><ControlTemplate.Triggers><Trigger Property="v:Accessible.FocusRingShown" Value="False"><Setter TargetName="Ring" Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- Named for screen readers after their text, also when it sits beside an icon (« Plus d’infos »); an explicit name wins. -->
  <Style TargetType="Button"><Setter Property="v:Motion.Interactive" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="ToolTipService.InitialShowDelay" Value="650"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static v:Accessible.ContentName}}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Raised2}"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><v:Squircle x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(v:Motion.Radius), RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid>
      <!-- Hover wash in the button's own ink: light on dark buttons, dark on white ones. Animated by Motion.Interactive. -->
      <v:Squircle x:Name="Hover" Depth="0" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" CornerRadius="{Binding Path=(v:Motion.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Grid></v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource OnAccent}"/></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource QuietButton}"/>
  <!-- The window's close button turns red under the pointer, as Windows' own does. -->
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="v:Motion.Interactive" Value="False"/><Setter Property="v:Motion.Radius" Value="0"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CloseHover}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource ClosePressed}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <!-- Icons are centred by alignment, not by padding: padding larger than the free space crops the glyph. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="v:Motion.HoverScale" Value="True"/></Style>
  <!-- Round, borderless player controls. -->
  <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="BorderThickness" Value="0"/><Setter Property="v:Motion.Radius" Value="22"/></Style>
  <!-- Floating action over the video (skip opening, next episode). -->
  <Style x:Key="PlayerPill" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Background" Value="{StaticResource Pill}"/><Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="20,12,17,12"/><Setter Property="FontSize" Value="14"/><Setter Property="v:Motion.Radius" Value="9"/></Style>
  <!-- Bottom bar of the player: compact round icon buttons in one row. -->
  <Style x:Key="PlayerBarButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="v:Motion.Radius" Value="20"/></Style>
  <!-- Rows, chips and headings of the player menus (audio, subtitles, speed). -->
  <Style x:Key="PlayerMenuItem" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="34"/><Setter Property="v:Motion.Radius" Value="6"/></Style>
  <Style x:Key="PlayerMenuChip" TargetType="Button" BasedOn="{StaticResource PlayerMenuItem}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0,7"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="2,0"/><Setter Property="MinHeight" Value="32"/></Style>
  <!-- Track and speed choices are radio buttons: screen readers announce which one is selected. -->
  <Style x:Key="PlayerMenuChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="34"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><v:Squircle x:Name="Chrome" Background="Transparent" CornerRadius="6"><Grid>
      <v:Squircle x:Name="Hover" Depth="0" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
      <DockPanel Margin="{TemplateBinding Padding}"><v:Icon x:Name="Check" Kind="check" Width="15" Height="15" Margin="1,0,11,0" Foreground="White" Visibility="Hidden" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></DockPanel>
    </Grid></v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.11"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.19"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerSpeedChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Margin" Value="2,0"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><v:Squircle x:Name="Chrome" Background="Transparent" CornerRadius="6"><Grid>
      <v:Squircle x:Name="Hover" Depth="0" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="6" IsHitTestVisible="False"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"/>
    </Grid></v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.11"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource OnAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerMenuHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Faint}"/><Setter Property="Margin" Value="10,6,10,8"/></Style>
  <Style x:Key="MiniTabButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="84"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{StaticResource Toast}"/><Setter Property="BorderBrush" Value="{StaticResource Hairline}"/><Setter Property="BorderThickness" Value="1,1,0,1"/><Setter Property="v:Motion.Radius" Value="12,0,0,12"/></Style>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="0"/><Setter Property="v:Motion.Radius" Value="13"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="17,13"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="v:Icon"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><v:Squircle x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><v:Squircle x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="13,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><v:Squircle x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Line}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="43"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><v:Squircle x:Name="Chrome" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Field}"><Grid><TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource TextBody}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" Margin="13,10,32,10" VerticalAlignment="Center"/><v:Icon Kind="down" Foreground="{StaticResource TextTertiary}" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,12,0"/></Grid></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Dim}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><v:Squircle Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="4"><ScrollViewer MaxHeight="340" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></v:Squircle></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="v:Motion.Switch" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="43"/><Setter Property="Height" Value="25"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><v:Squircle x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="{StaticResource LineStrong}" BorderThickness="1" BorderBrush="Transparent"><Ellipse x:Name="Dot" Width="17" Height="17" Fill="{StaticResource Text}" HorizontalAlignment="Left" Margin="3,0"/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource HairlineStrong}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="22"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><v:Squircle Height="3" Background="{StaticResource Accent}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Text}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><v:Squircle Height="3" Background="{StaticResource LineStrong}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><v:Squircle Background="{StaticResource LineStrong}" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- No vertical bar: the wheel, the touchpad, the keys and the finger scroll a page, and the bar only took room. -->
  <!-- Every list scrolls the same way, smoothly, the one under the pointer first (SmoothScroll). -->
  <Style TargetType="ScrollViewer"><Setter Property="v:SmoothScroll.Enabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid Background="{TemplateBinding Background}"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Height="6" Width="Auto" Orientation="Horizontal" Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="Background" Value="{StaticResource Raised2}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="12"/></Style>
  <!-- Expander: a chevron and its title in Mira's ink, with the focus ring of the other controls (Aero2 draws a black dotted line). -->
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><DockPanel>
      <ToggleButton x:Name="HeaderButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Cursor="Hand" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal" Background="Transparent"><v:Icon x:Name="Chevron" Kind="next" Width="14" Height="14" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
          <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Kind" Value="down"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
    </DockPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="22,21"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="SettingDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/><Setter Property="Margin" Value="0,7,30,0"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><v:Squircle Background="{StaticResource Menu}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="220"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></v:Squircle></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="11,9,16,9"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><v:Squircle x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><DockPanel><v:Icon x:Name="Glyph" DockPanel.Dock="Left" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Foreground="{StaticResource TextBody}" Margin="0,0,12,0"/><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel></v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Line}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".4"/></Trigger>
      <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
