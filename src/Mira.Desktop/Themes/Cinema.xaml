<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:Mira.Desktop.Views"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" mc:Ignorable="po">
  <!-- Mira's palette, the one source of the window's colours: the names and the neutrals of Mira web (app.css) and of
       the Mac (App.axaml). Frozen brushes are shared and never changed in place; Muted, Faint, FocusRing and FieldFocus are not
       frozen: high contrast replaces them (MainWindow.Accessibility), so they are read as DynamicResource. -->
  <!-- Corner radii, the only six: Small (chips, fields), Control (buttons, banners, the rows of a menu), Card (cards, tiles,
       posters), Menu (a menu: right click, a list, a small menu of the player), Popover (the larger windows that open
       over a page or the player: audio and subtitles, episodes, ⋮, « Get season »), Sheet (dialogs). Circles and pills
       (radius = half the height), progress bars and the window frame keep the radius their shape needs. In code:
       Palette.Small, Palette.Control, Palette.Card, Palette.Menu, Palette.Popover, Palette.Sheet. -->
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusControl">10</CornerRadius>
  <CornerRadius x:Key="RadiusCard">11</CornerRadius>
  <CornerRadius x:Key="RadiusMenu">14</CornerRadius>
  <CornerRadius x:Key="RadiusPopover">16</CornerRadius>
  <CornerRadius x:Key="RadiusSheet">20</CornerRadius>
  <!-- Surfaces, darkest first: the window, panels and rows, fields and lists, raised tiles, buttons, lines. -->
  <SolidColorBrush x:Key="Bg" Color="#000000"/>
  <SolidColorBrush x:Key="Surface" Color="#111111"/>
  <SolidColorBrush x:Key="Field" Color="#121212" po:Freeze="True"/>
  <SolidColorBrush x:Key="Raised" Color="#1C1C1C" po:Freeze="True"/>
  <SolidColorBrush x:Key="Raised2" Color="#242424" po:Freeze="True"/>
  <!-- The solid pill of a segmented switch (ChoiceTrack), lighter than any track it moves in: a body, never a frame. -->
  <SolidColorBrush x:Key="TrackPill" Color="#363636" po:Freeze="True"/>
  <SolidColorBrush x:Key="Line" Color="#2A2A2A" po:Freeze="True"/>
  <SolidColorBrush x:Key="LineStrong" Color="#3F3F3F" po:Freeze="True"/>
  <!-- Inside a menu (« Écrin », 2026-11-14): the rules between its parts, and the sunk track of a slider of choices or of « − 0.0 s + ». -->
  <SolidColorBrush x:Key="Rule" Color="#222222" po:Freeze="True"/>
  <SolidColorBrush x:Key="Inset" Color="#0A0A0A" po:Freeze="True"/>
  <!-- Ink, lightest first. Every text one reads at 4.5:1 or more on Mira's surfaces (AccessibilityTests); Dim is for
       glyphs and dots only, never for text. -->
  <SolidColorBrush x:Key="Text" Color="#F5F5F5" po:Freeze="True"/>
  <SolidColorBrush x:Key="TextBody" Color="#E0E0E0" po:Freeze="True"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#C7C7C7" po:Freeze="True"/>
  <SolidColorBrush x:Key="TextTertiary" Color="#B9B9B9" po:Freeze="True"/>
  <SolidColorBrush x:Key="Muted" Color="#A3A3A3"/>
  <!-- Small labels and hints: the dimmest text that still reads at 4.5:1 on Mira's surfaces (5.5:1 on #111111). -->
  <SolidColorBrush x:Key="Faint" Color="#8C8C8C"/>
  <SolidColorBrush x:Key="Dim" Color="#757575" po:Freeze="True"/>
  <!-- The ink of a light button (Accent behind it). -->
  <SolidColorBrush x:Key="OnAccent" Color="#121212" po:Freeze="True"/>
  <!-- States: done, waiting or offline, failed. The warning has its own text, surface and line for the offline badge. -->
  <SolidColorBrush x:Key="Success" Color="#86C6A2" po:Freeze="True"/>
  <SolidColorBrush x:Key="Warning" Color="#D5B787" po:Freeze="True"/>
  <SolidColorBrush x:Key="WarningText" Color="#E9DCC3" po:Freeze="True"/>
  <SolidColorBrush x:Key="WarningSurface" Color="#F21C1A16" po:Freeze="True"/>
  <SolidColorBrush x:Key="WarningLine" Color="#4D8C7650" po:Freeze="True"/>
  <SolidColorBrush x:Key="SuccessSurface" Color="#1F86C6A2" po:Freeze="True"/>
  <SolidColorBrush x:Key="SuccessLine" Color="#5986C6A2" po:Freeze="True"/>
  <SolidColorBrush x:Key="Danger" Color="#F3AD99" po:Freeze="True"/>
  <!-- The window's close button, Windows' own red. -->
  <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" po:Freeze="True"/>
  <SolidColorBrush x:Key="ClosePressed" Color="#B0271A" po:Freeze="True"/>
  <!-- See-through layers: lines and washes of white over video or artwork, menus and messages, sheets over the page. -->
  <SolidColorBrush x:Key="Hairline" Color="#30FFFFFF" po:Freeze="True"/>
  <SolidColorBrush x:Key="HairlineStrong" Color="#5CFFFFFF" po:Freeze="True"/>
  <SolidColorBrush x:Key="Wash" Color="#24FFFFFF" po:Freeze="True"/>
  <SolidColorBrush x:Key="Menu" Color="#F5151515" po:Freeze="True"/>
  <SolidColorBrush x:Key="Toast" Color="#F0242424" po:Freeze="True"/>
  <SolidColorBrush x:Key="Pill" Color="#E0161616" po:Freeze="True"/>
  <SolidColorBrush x:Key="Sheet" Color="#F0111111" po:Freeze="True"/>
  <SolidColorBrush x:Key="Scrim" Color="#F4000000" po:Freeze="True"/>
  <!-- Réglages and Aide, a window over Mira (MainWindow.Sheet.cs): the wash over the still of the app behind, the column of its list, its rows. -->
  <SolidColorBrush x:Key="SheetScrim" Color="#80000000" po:Freeze="True"/>
  <SolidColorBrush x:Key="SheetSide" Color="#0C0C0C" po:Freeze="True"/>
  <SolidColorBrush x:Key="SheetRow" Color="#181818" po:Freeze="True"/>
  <!-- Keyboard focus ring; Windows' highlight colour in high contrast (MainWindow). -->
  <SolidColorBrush x:Key="FocusRing" Color="#F5F5F5"/>
  <!-- A text field being typed in: flat, one step lighter, a quiet grey edge (3:1 on the page); high contrast: the system highlight. -->
  <SolidColorBrush x:Key="FieldFocus" Color="#6B6B6B"/>
  <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Nunito</FontFamily>
  <SolidColorBrush x:Key="Accent" Color="#F5F5F5"/>
  <!-- Text in Ideal mode, grayscale: Nunito carries no hinting, and Display mode (GDI-classic metrics, no vertical
       anti-aliasing) drew its curves in steps, worst on titles. Popups are windows of their own: same setters. -->
  <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/></Style>
  <!-- Shown only when focus arrives from the keyboard; mouse clicks no longer leave a white outline. -->
  <Style x:Key="KeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><v:Squircle x:Name="Ring" Margin="-3" CornerRadius="{StaticResource RadiusControl}" BorderBrush="{DynamicResource FocusRing}" BorderThickness="2" SnapsToDevicePixels="True"/><ControlTemplate.Triggers><Trigger Property="v:Accessible.FocusRingShown" Value="False"><Setter TargetName="Ring" Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- Named for screen readers after their text, also when it sits beside an icon (« Plus d’infos »); an explicit name wins. -->
  <Style TargetType="Button"><Setter Property="v:Motion.Interactive" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="ToolTipService.InitialShowDelay" Value="650"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static v:Accessible.ContentName}}"/>
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Raised2}"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Chrome">
      <v:Squircle Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(v:Motion.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
      <!-- Hover wash in the button's own ink: light on dark buttons, dark on white ones. Set at once by Motion.Interactive, never animated.
           The whole shape, under the edge: inside the edge at the same radius, its corners fell short of the edge's and left a seam. -->
      <v:Squircle x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False" CornerRadius="{Binding Path=(v:Motion.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
      <v:Squircle CornerRadius="{Binding Path=(v:Motion.Radius), RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </v:Squircle>
    </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource OnAccent}"/></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource QuietButton}"/>
  <!-- The window's close button turns red under the pointer, as Windows' own does. -->
  <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="v:Motion.Interactive" Value="False"/><Setter Property="v:Motion.Radius" Value="0"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CloseHover}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource ClosePressed}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <!-- Icons are centred by alignment, not by padding: padding larger than the free space crops the glyph. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/></Style>
  <!-- Borderless player controls over the picture: no wash under them (a grey disc over the film), the glyph alone lights up
       under the pointer, at once. No tooltip: the icons say what they do (names kept for screen readers). -->
  <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="BorderThickness" Value="0"/><Setter Property="v:Motion.Radius" Value="22"/><Setter Property="v:Motion.Interactive" Value="False"/><Setter Property="Opacity" Value="0.8"/><Setter Property="ToolTipService.IsEnabled" Value="False"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger></Style.Triggers>
  </Style>
  <!-- Floating action over the video (skip opening, next episode). -->
  <Style x:Key="PlayerPill" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Background" Value="{StaticResource Pill}"/><Setter Property="BorderBrush" Value="{StaticResource HairlineStrong}"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="20,12,17,12"/><Setter Property="FontSize" Value="14"/><Setter Property="v:Motion.Radius" Value="{StaticResource RadiusControl}"/></Style>
  <!-- Bottom bar of the player: compact round icon buttons in one row. -->
  <!-- The player's title and episode line: plain text that opens its page, underlined under the pointer and lit when focused. -->
  <Style x:Key="PlayerTitleLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="v:Motion.Interactive" Value="False"/><Setter Property="ToolTipService.IsEnabled" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/></Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="TextDecorations" Value="Underline"/><Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PlayerBarButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="v:Motion.Radius" Value="20"/></Style>
  <!-- Rows, chips and headings of the player menus (audio, subtitles, episodes, ⋮), « Écrin » (2026-11-14, maquette A
       chosen by ogsas, /mnt/project-files/popovers/): the grey of the Réglages window, rows rounded inside it, the one chosen
       raised (Raised) and in bold with its check on the right, settings in sunk sliders of choices. Nothing animates. -->
  <Style x:Key="PlayerMenuItem" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="38"/><Setter Property="v:Motion.Radius" Value="{StaticResource RadiusControl}"/></Style>
  <!-- A small square button of a menu (a season's arrows, « − » and « + » of a delay): its glyph in the secondary ink. -->
  <Style x:Key="PlayerMenuChip" TargetType="Button" BasedOn="{StaticResource PlayerMenuItem}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/></Style>
  <!-- « − 0.0 s + »: a capsule sunk in the menu, its value in bold between the two steps. -->
  <Style x:Key="PlayerStepper" TargetType="Border"><Setter Property="Background" Value="{StaticResource Inset}"/><Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/><Setter Property="Padding" Value="2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="PlayerStep" TargetType="Button" BasedOn="{StaticResource PlayerMenuChip}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="v:Motion.Radius" Value="8"/></Style>
  <Style x:Key="PlayerStepValue" TargetType="Button" BasedOn="{StaticResource PlayerStep}"><Setter Property="Width" Value="56"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
  <!-- Track and episode choices, a pack of « Get season »: radio buttons (and check boxes), so that screen readers say which is chosen. -->
  <Style x:Key="PlayerMenuChoice" TargetType="ToggleButton"><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="38"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><v:Squircle x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource RadiusControl}">
      <DockPanel Margin="{TemplateBinding Padding}"><v:Icon x:Name="Check" DockPanel.Dock="Right" Kind="check" Width="16" Height="16" Margin="12,0,0,0" Foreground="{StaticResource Text}" Visibility="Hidden" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></DockPanel>
    </v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised2}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- One choice among a few, with more to say than a word (« Get season »'s packs): its round radio on the left, its words, the one chosen raised, in bold, the radio filled. -->
  <Style x:Key="PopoverRadio" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Padding" Value="14,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><v:Squircle x:Name="Chrome" Background="Transparent" CornerRadius="11">
      <DockPanel Margin="{TemplateBinding Padding}"><Ellipse x:Name="Ring" DockPanel.Dock="Left" Width="18" Height="18" Stroke="{StaticResource Dim}" StrokeThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></DockPanel>
    </v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised2}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Text}"/><Setter TargetName="Ring" Property="StrokeThickness" Value="5.5"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A setting of a menu that is on or off (Son de nuit): its words, then a switch on the right, the one of the Réglages. -->
  <Style x:Key="PlayerMenuSwitch" TargetType="CheckBox"><Setter Property="v:Motion.Switch" Value="True"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="38"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><v:Squircle x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource RadiusControl}">
      <DockPanel Margin="{TemplateBinding Padding}"><v:Squircle x:Name="Track" DockPanel.Dock="Right" Width="40" Height="24" CornerRadius="12" Background="{StaticResource LineStrong}" Margin="12,0,0,0" VerticalAlignment="Center"><Ellipse x:Name="Dot" Width="18" Height="18" Fill="{StaticResource Text}" HorizontalAlignment="Left" Margin="3,0"/></v:Squircle><ContentPresenter VerticalAlignment="Center"/></DockPanel>
    </v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A slider of choices (quality, sleep timer, a language): cells side by side in a sunk track (PlayerSlider), the one chosen raised with its edge. -->
  <Style x:Key="PlayerSlider" TargetType="Border"><Setter Property="Background" Value="{StaticResource Inset}"/><Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="12,0"/></Style>
  <!-- A part of a ChoiceTrack: the track paints its ink and draws the pill under the chosen one, so no background, edge or weight of its own. -->
  <Style x:Key="PlayerSpeedChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="MinHeight" Value="32"/><Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border Background="{TemplateBinding Background}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Titles of a menu's parts, in sentence case (« Audio », « Sleep timer »). -->
  <Style x:Key="PlayerMenuHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Margin" Value="12,10,12,8"/></Style>
  <!-- A line between a menu's parts. -->
  <Style x:Key="PlayerMenuRule" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource Rule}"/><Setter Property="Margin" Value="10,6"/></Style>
  <!-- The window of a menu: the one of the player, « Get season », and the frame of a right click and of a list. -->
  <Style x:Key="PopoverWindow" TargetType="v:Squircle"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource RadiusPopover}"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="48"/><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="0"/><Setter Property="v:Motion.Radius" Value="{StaticResource RadiusCard}"/><Setter Property="Foreground" Value="{StaticResource TextBody}"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="17,13"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="v:Icon"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><v:Squircle x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FieldFocus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><v:Squircle x:Name="Chrome" CornerRadius="{StaticResource RadiusSmall}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FieldFocus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A row of a list, as a row of the player's menus: the one chosen raised, in bold, its check on the right. -->
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource TextBody}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><v:Squircle x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource RadiusControl}"><DockPanel><v:Icon x:Name="Check" DockPanel.Dock="Right" Kind="check" Width="15" Height="15" Margin="12,0,0,0" Foreground="{StaticResource Text}" Visibility="Hidden" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></DockPanel></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontWeight" Value="Bold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="43"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><v:Squircle x:Name="Chrome" CornerRadius="{StaticResource RadiusSmall}" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Field}"><Grid><TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{StaticResource TextBody}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextTrimming="CharacterEllipsis" Margin="13,10,32,10" VerticalAlignment="Center"/><v:Icon Kind="down" Foreground="{StaticResource TextTertiary}" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,12,0"/></Grid></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Dim}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FieldFocus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><v:Squircle Style="{StaticResource PopoverWindow}" CornerRadius="{StaticResource RadiusMenu}" Padding="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,6,0,0"><ScrollViewer MaxHeight="340" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></v:Squircle></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="v:Motion.Switch" Value="True"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Width" Value="43"/><Setter Property="Height" Value="25"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><v:Squircle x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="{StaticResource LineStrong}" BorderThickness="1" BorderBrush="Transparent"><Ellipse x:Name="Dot" Width="17" Height="17" Fill="{StaticResource Text}" HorizontalAlignment="Left" Margin="3,0"/></v:Squircle><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource HairlineStrong}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="22"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><v:Squircle Height="3" Background="{StaticResource Accent}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Text}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><v:Squircle Height="3" Background="{StaticResource LineStrong}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><v:Squircle Background="{StaticResource LineStrong}" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- No vertical bar: the wheel, the touchpad, the keys and the finger scroll a page, and the bar only took room. -->
  <!-- Every list scrolls the same way, smoothly, the one under the pointer first (SmoothScroll). -->
  <Style TargetType="ScrollViewer"><Setter Property="v:SmoothScroll.Enabled" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid Background="{TemplateBinding Background}"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Height="6" Width="Auto" Orientation="Horizontal" Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <!-- A tooltip in the grey of the menus, rounded, with their edge. -->
  <Style TargetType="ToolTip"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><v:Squircle Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></v:Squircle></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Expander: a chevron and its title in Mira's ink, with the focus ring of the other controls (Aero2 draws a black dotted line). -->
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource TextTertiary}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><DockPanel>
      <ToggleButton x:Name="HeaderButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Cursor="Hand" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FocusVisualStyle="{StaticResource KeyboardFocus}" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal" Background="Transparent"><v:Icon x:Name="Chevron" Kind="next" Width="14" Height="14" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
          <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Kind" Value="down"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
    </DockPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingRow" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="22,21"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <!-- A setting in the window of Réglages and Aide: one step lighter than its sheet (Surface). Each page there names it SettingRow. -->
  <Style x:Key="SheetSettingRow" TargetType="Border" BasedOn="{StaticResource SettingRow}"><Setter Property="Background" Value="{StaticResource SheetRow}"/><Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/><Setter Property="Padding" Value="22,19"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <!-- The window itself, centred, at most 1180 × 840: it fills a small Mira, under the title bar. -->
  <Style x:Key="SheetWindow" TargetType="v:Squircle"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource RadiusSheet}"/><Setter Property="ClipContent" Value="True"/><Setter Property="MaxWidth" Value="1180"/><Setter Property="MaxHeight" Value="840"/><Setter Property="Margin" Value="44,52,44,36"/></Style>
  <!-- Réglages | Aide at the top of its list: the side shown lit, the other quiet. -->
  <!-- A part of Réglages | Aide: no background of its own, the switch (Views/Segmented.cs) slides its pill under it and paints its ink. -->
  <Style x:Key="SheetSwitch" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="v:Motion.Radius" Value="9"/><Setter Property="v:Motion.Interactive" Value="False"/></Style>
  <Style x:Key="SheetNav" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="FontSize" Value="14"/></Style>
  <!-- The small capitals over a column of the Downloads page's tables (« Régie »). -->
  <Style x:Key="ServerCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Faint}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="SettingDescription" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/><Setter Property="Margin" Value="0,7,30,0"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><v:Squircle Style="{StaticResource PopoverWindow}" CornerRadius="{StaticResource RadiusMenu}" Padding="6" MinWidth="232"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></v:Squircle></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,0,16,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><v:Squircle x:Name="Row" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}"><DockPanel><v:Icon x:Name="Glyph" DockPanel.Dock="Left" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="17" Height="17" Foreground="{StaticResource TextSecondary}" Margin="0,0,13,0" VerticalAlignment="Center"/><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel></v:Squircle><ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value=".4"/></Trigger>
      <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource Rule}" Margin="10,6"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
