      <Button x:Name="TorLinkSettingsButton" Style="{StaticResource Quiet}" Click="TorLinkSettings_Click" ToolTip="{v:L 'Rangement, dossiers et emplacement de TorLink', 'Sorting, folders and TorLink’s location'}" AutomationProperties.Name="{v:L 'Réglages de TorLink', 'TorLink settings'}"><StackPanel Orientation="Horizontal"><v:Icon Kind="sliders" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{v:L 'Réglages', 'Settings'}"/></StackPanel></Button>
