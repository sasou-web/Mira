      <Button x:Name="PlayerErrorAction" Style="{StaticResource Primary}" v:Motion.Radius="9" Click="PlayerErrorAction_Click"/>
     </StackPanel>
    </StackPanel>
   </Grid>
   <playback:PlayerOverlay x:Name="PlayerOverlayLayer" PlacementTarget="{Binding ElementName=PlayerShell}">
    <!-- The decorator gives the separate overlay window an adorner layer for keyboard focus rings. -->
    <AdornerDecorator>
    <Grid x:Name="PlayerSurface" Background="#01000000" Focusable="True" FocusVisualStyle="{x:Null}" ClipToBounds="True" Cursor="Arrow" TextElement.FontFamily="{StaticResource AppFont}" MouseMove="PlayerSurface_MouseMove" MouseLeave="PlayerSurface_MouseLeave" MouseLeftButtonDown="PlayerSurface_MouseDown" MouseLeftButtonUp="PlayerSurface_MouseUp" PreviewKeyDown="Player_PreviewKeyDown" KeyDown="Window_KeyDown">
    <!-- Top: back to the library, or the mini-player's title and buttons. The title of a full player sits in the bottom bar.
         The shades take no clicks, but a click in the band of a bar never pauses (InBarBand). -->
    <Grid x:Name="PlayerHeader" Height="108" VerticalAlignment="Top">
     <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A6000000"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <DockPanel x:Name="PlayerHeaderBody" Margin="24,42,24,22" VerticalAlignment="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="MiniExpandButton" Visibility="Collapsed" Style="{StaticResource PlayerButton}" Width="32" Height="32" v:Motion.Radius="16" Click="ExpandPlayer_Click" ToolTip="{v:L 'Agrandir le lecteur · I', 'Expand the player · I'}" AutomationProperties.Name="{v:L 'Agrandir le lecteur', 'Expand the player'}"><v:Icon Kind="expand" Width="17" Height="17"/></Button><Button x:Name="MiniCloseButton" Visibility="Collapsed" Style="{StaticResource PlayerButton}" Width="32" Height="32" v:Motion.Radius="16" Margin="2,0,0,0" Click="StopPlayer_Click" ToolTip="{v:L 'Fermer le mini-lecteur', 'Close the mini player'}" AutomationProperties.Name="{v:L 'Fermer le mini-lecteur', 'Close the mini player'}"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel>
      <Button x:Name="PlayerBackButton" DockPanel.Dock="Left" Style="{StaticResource PlayerButton}" Click="MiniPlayer_Click" ToolTip="{v:L 'Revenir à la bibliothèque · Échap', 'Back to the library · Esc'}" AutomationProperties.Name="{v:L 'Revenir à la bibliothèque', 'Back to the library'}"><v:Icon Kind="down"/></Button>
      <TextBlock x:Name="MiniTitle" Visibility="Collapsed" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="2,0,10,0" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Grid>
