      <Button x:Name="DownloadersButton" Style="{StaticResource Quiet}" Click="Downloaders_Click" ToolTip="{v:L 'Activer ou désactiver un téléchargeur', 'Turn a downloader on or off'}" AutomationProperties.Name="{v:L 'Téléchargeurs', 'Downloaders'}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><v:Icon Kind="library" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{v:L 'Téléchargeurs', 'Downloaders'}"/></StackPanel></Button>
