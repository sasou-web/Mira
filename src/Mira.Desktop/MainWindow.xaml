         then play, next episode and volume on the left, the menus, mini-player and fullscreen on the right. -->
    <Grid x:Name="PlayerControls" Height="210" VerticalAlignment="Bottom">
     <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#8C000000" Offset="0.5"/><GradientStop Color="#EB000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Grid x:Name="PlayerControlsBody" Margin="24,0,24,14" VerticalAlignment="Bottom"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="PlayerInfo" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Bottom" Margin="0,0,32,0"><TextBlock x:Name="PlayingTitle" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayingSubtitle" Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
