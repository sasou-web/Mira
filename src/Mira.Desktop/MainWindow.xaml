      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#30070708" Offset="0"/><GradientStop Color="#00070708" Offset="0.3"/><GradientStop Color="#46070708" Offset="0.64"/><GradientStop Color="#F4070708" Offset="0.96"/><GradientStop Color="#FF070708" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <StackPanel x:Name="HeroCopy" Width="625" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="110,0,0,81">
       <Image x:Name="HeroLogo" MaxWidth="540" Height="118" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,22"/>
       <TextBlock x:Name="HeroTitle" Text="Ta prochaine séance." FontSize="53" LineHeight="57" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" Margin="-3,0,0,21"/>
       <WrapPanel x:Name="HeroMetaPills" Margin="0,0,0,21"/>
       <TextBlock x:Name="HeroSmallOverview" Foreground="#BDBDC3" TextWrapping="Wrap" LineHeight="21" MaxHeight="43" Margin="0,0,0,21" Visibility="Collapsed"/>
       <StackPanel Orientation="Horizontal"><Button x:Name="HeroPlay" Style="{StaticResource Primary}" Padding="26,13" MinWidth="165" Click="HeroPlay_Click"><StackPanel Orientation="Horizontal"><v:Icon Kind="play" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock x:Name="HeroPlayText" Text="Regarder" FontWeight="SemiBold"/></StackPanel></Button><Button Click="HeroDetails_Click" Background="#443B3B3F" Margin="10,0,10,0" Padding="20,13"><StackPanel Orientation="Horizontal"><v:Icon Kind="info" Width="19" Height="19" Margin="0,0,9,0"/><TextBlock Text="Plus d’infos"/></StackPanel></Button><Button x:Name="HeroFavorite" Click="HeroFavorite_Click" Style="{StaticResource IconButton}" ToolTip="Ajouter aux favoris" AutomationProperties.Name="Ajouter aux favoris"><v:Icon Kind="heart"/></Button></StackPanel>
