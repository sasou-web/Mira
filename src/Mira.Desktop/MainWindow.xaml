     <TextBlock x:Name="PlayerErrorTitle" FontSize="14" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,6,0,0"/>
     <TextBlock x:Name="PlayerErrorText" FontSize="14" LineHeight="21" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
