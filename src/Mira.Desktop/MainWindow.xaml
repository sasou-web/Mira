      <Grid x:Name="PlayerTransport" Grid.Row="2" Margin="-8,2,-8,0" Height="44"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel x:Name="PlayerLeftGroup" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PauseButton" Style="{StaticResource PlayerBarButton}" Click="Pause_Click" ToolTip="{v:L 'Pause · Espace', 'Pause · Space'}" AutomationProperties.Name="Pause"><v:Icon x:Name="PauseIcon" Kind="pause" Width="24" Height="24"/></Button><Button x:Name="PreviousButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Previous_Click" ToolTip="{v:L 'Épisode précédent', 'Previous episode'}" AutomationProperties.Name="{v:L 'Épisode précédent', 'Previous episode'}"><v:Icon Kind="previous-episode"/></Button><Button x:Name="NextButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Next_Click" ToolTip="{v:L 'Épisode suivant', 'Next episode'}" AutomationProperties.Name="{v:L 'Épisode suivant', 'Next episode'}"><v:Icon Kind="next-episode"/></Button>
        <!-- The volume slider slides out of the speaker while the pointer is on it, as on streaming players. -->
        <StackPanel x:Name="PlayerVolumeGroup" Orientation="Horizontal" Margin="6,0,0,0" Background="Transparent" MouseEnter="VolumeGroup_MouseEnter" MouseLeave="VolumeGroup_MouseLeave" PreviewMouseWheel="VolumeGroup_MouseWheel"><Button x:Name="MuteButton" Style="{StaticResource PlayerBarButton}" Click="Mute_Click" GotKeyboardFocus="VolumeGroup_FocusChanged" LostKeyboardFocus="VolumeGroup_FocusChanged" ToolTip="{v:L 'Couper le son · M', 'Mute · M'}" AutomationProperties.Name="{v:L 'Couper le son', 'Mute'}"><v:Icon x:Name="VolumeIcon" Kind="volume"/></Button><Border x:Name="VolumeReveal" Width="0" ClipToBounds="True" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><!-- 100 % sits at the middle, marked under the track; to the right, the sound is raised without clipping. --><Grid Width="112" Margin="6,0,8,0"><Border Width="2" Height="10" CornerRadius="1" Background="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="5" Focusable="False" ValueChanged="Volume_Changed" LostMouseCapture="VolumeSlider_LostMouseCapture" ToolTip="{v:L 'Au-delà de 100 %, le son est amplifié sans saturer', 'Above 100%, the sound is boosted without distorting'}" AutomationProperties.Name="Volume"/></Grid><TextBlock x:Name="VolumeText" Width="40" Margin="0,0,8,0" FontSize="12" Foreground="{StaticResource TextTertiary}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/></StackPanel></Border></StackPanel></StackPanel>
       <StackPanel x:Name="PlayerRightGroup" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PlayerEpisodesButton" Style="{StaticResource PlayerBarButton}" Margin="0,0,6,0" Click="Episodes_Click" ToolTip="{v:L 'Épisodes · E', 'Episodes · E'}" AutomationProperties.Name="{v:L 'Épisodes', 'Episodes'}"><v:Icon Kind="episodes"/></Button><Button x:Name="PlayerMoreButton" Style="{StaticResource PlayerBarButton}" Click="More_Click" ToolTip="{v:L 'Vitesse, décalage des sous-titres et informations', 'Speed, subtitle delay and info'}" AutomationProperties.Name="{v:L 'Plus d’options', 'More options'}"><v:Icon Kind="more"/></Button><Button x:Name="PlayerTracksButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Tracks_Click" ToolTip="{v:L 'Audio et sous-titres', 'Audio and subtitles'}" AutomationProperties.Name="{v:L 'Audio et sous-titres', 'Audio and subtitles'}"><v:Icon Kind="subtitles"/></Button><Button x:Name="MiniPlayerButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="MiniPlayer_Click" ToolTip="{v:L 'Mini-lecteur · I', 'Mini player · I'}" AutomationProperties.Name="{v:L 'Mini-lecteur', 'Mini player'}"><v:Icon Kind="mini"/></Button><Button x:Name="FullscreenButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Fullscreen_Click" ToolTip="{v:L 'Plein écran · F', 'Full screen · F'}" AutomationProperties.Name="{v:L 'Plein écran', 'Full screen'}"><v:Icon x:Name="FullscreenIcon" Kind="fullscreen"/></Button></StackPanel>
      </Grid>
     </Grid>
