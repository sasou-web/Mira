      <StackPanel x:Name="SubtitleSearchMenu" Width="400" Visibility="Collapsed">
       <DockPanel Margin="4,0,4,4"><Button DockPanel.Dock="Left" Style="{StaticResource PlayerMenuChip}" Width="34" Margin="0" Click="SubtitleSearchBack_Click" ToolTip="{v:L 'Audio et sous-titres', 'Audio and subtitles'}" AutomationProperties.Name="{v:L 'Retour à l’audio et aux sous-titres', 'Back to audio and subtitles'}"><v:Icon Kind="back" Width="15" Height="15"/></Button><TextBlock Text="{v:L 'Chercher des sous-titres', 'Search for subtitles'}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,34,0"/></DockPanel>
       <TextBlock x:Name="SubtitleSearchPrivacy" Margin="10,2,10,10" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
       <StackPanel x:Name="SubtitleLanguageList" Orientation="Horizontal" Margin="8,0,8,8"/>
       <TextBlock x:Name="SubtitleSearchStatus" Margin="10,2,10,6" FontSize="12.5" Foreground="{StaticResource TextBody}" TextWrapping="Wrap" v:Accessible.Announce="Polite"/>
       <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SubtitleResultList" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </StackPanel>
      <StackPanel x:Name="MoreMenu" Width="300" Visibility="Collapsed">
