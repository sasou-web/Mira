      <TextBlock x:Name="LoginError" Foreground="#F3AD99" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Button x:Name="ConnectButton" Style="{StaticResource Primary}" v:Motion.Radius="9" Click="Connect_Click" Height="46" Margin="0,24,0,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ConnectText" Text="Ouvrir ma bibliothèque" FontSize="13"/><v:Icon Kind="next" Width="16" Height="16" Margin="10,0,0,0"/></StackPanel></Button>
      <Button Content="Essayer sans se connecter" Style="{StaticResource Quiet}" Click="Demo_Click" FontSize="12" Foreground="#B7B7BE" Margin="0,10,0,0" Height="40"/>
      <Button x:Name="LogoutButton" Content="Déconnecter ce compte" Style="{StaticResource Quiet}" Click="Logout_Click" FontSize="12" Foreground="#A2A2AA" Margin="0,3,0,0" Visibility="Collapsed"/>
     </StackPanel>
    </Border>
   </ScrollViewer>
  </Grid>

  <Grid x:Name="TitleBar" Panel.ZIndex="80" Background="Transparent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Minimize_Click" ToolTip="Réduire la fenêtre" AutomationProperties.Name="Réduire la fenêtre"><v:Icon Kind="minus" Width="16" Height="16"/></Button><Button x:Name="MaximizeButton" Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Maximize_Click" ToolTip="Agrandir la fenêtre" AutomationProperties.Name="Agrandir la fenêtre"><v:Icon x:Name="MaximizeIcon" Kind="maximize" Width="15" Height="15"/></Button><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Close_Click" ToolTip="Fermer Mira" AutomationProperties.Name="Fermer Mira"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel></Grid>
  <Border x:Name="Notice" Grid.RowSpan="2" Panel.ZIndex="90" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="760" Margin="80,0,30,25" Padding="17,10,8,10" Background="#F0222227" BorderBrush="#43434A" BorderThickness="1" CornerRadius="8"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Click="DismissNotice_Click" ToolTip="Masquer" AutomationProperties.Name="Masquer le message"><v:Icon Kind="close" Width="15" Height="15"/></Button><TextBlock x:Name="NoticeText" VerticalAlignment="Center" FontSize="12" Foreground="#DDDEE4" TextWrapping="Wrap" Margin="0,0,10,0"/></DockPanel></Border>
 </Grid>
</Window>
