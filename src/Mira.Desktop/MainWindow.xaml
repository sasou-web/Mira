      <DockPanel Margin="0,18,0,0"><Button x:Name="IdentifySearch" DockPanel.Dock="Right" Style="{StaticResource Primary}" v:Motion.Radius="9" Padding="20,10" Margin="10,0,0,0" Click="IdentifySearch_Click"/><TextBox x:Name="IdentifyYear" DockPanel.Dock="Right" Width="76" MaxLength="4" Margin="10,0,0,0" KeyDown="IdentifyBox_KeyDown" AutomationProperties.Name="{v:L 'Année', 'Year'}"/><TextBox x:Name="IdentifyName" KeyDown="IdentifyBox_KeyDown" AutomationProperties.Name="{v:L 'Titre à chercher, ou lien TMDb ou IMDb', 'Title to search for, or a TMDb or IMDb link'}"/></DockPanel>
      <TextBlock x:Name="IdentifyStatus" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" v:Accessible.Announce="Polite"/>
      <ScrollViewer x:Name="IdentifyScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><StackPanel x:Name="IdentifyResults" v:Accessible.ArrowKeys="True"/></ScrollViewer>
      <StackPanel x:Name="IdentifyConfirm" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock x:Name="IdentifyQuestion" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{v:L 'Jellyfin remplace son titre, son résumé, ses affiches et sa distribution par ceux de ce titre, sur chaque appareil. Le fichier ne bouge pas.', 'Jellyfin replaces its title, summary, posters and cast with this title’s, on every device. The file stays where it is.'}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/><StackPanel Orientation="Horizontal"><Button x:Name="IdentifyApply" Style="{StaticResource Primary}" v:Motion.Radius="9" Content="{v:L 'Remplacer', 'Replace'}" Padding="22,10" Click="IdentifyApply_Click"/><Button Content="{v:L 'Retour', 'Back'}" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="IdentifyBack_Click"/></StackPanel></StackPanel>
      <DockPanel Margin="0,16,0,0"><Button Content="{v:L 'Fermer', 'Close'}" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Click="IdentifyClose_Click"/></DockPanel>
     </StackPanel>
    </Border>
   </Viewbox>
  </Grid>
  <Grid x:Name="TitleBar" Panel.ZIndex="80" Background="Transparent"><Border x:Name="OfflineBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="84,5,0,0" Padding="11,2,3,2" CornerRadius="12" Background="{StaticResource WarningSurface}" BorderBrush="{StaticResource WarningLine}" BorderThickness="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{v:L 'Jellyfin ne répond pas : Mira montre ce qu’il avait gardé et réessaie tout seul.', 'Jellyfin isn’t answering: Mira shows what it had kept and tries again on its own.'}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="OfflineText" Text="{v:L 'Hors connexion', 'Offline'}" FontSize="12" Foreground="{StaticResource WarningText}" VerticalAlignment="Center"/><Button x:Name="OfflineRetry" Content="{v:L 'Réessayer', 'Try again'}" Style="{StaticResource Quiet}" FontSize="12" Padding="10,3" Margin="8,0,0,0" v:Motion.Radius="10" Click="OfflineRetry_Click" AutomationProperties.Name="{v:L 'Réessayer de joindre Jellyfin', 'Try reaching Jellyfin again'}"/></StackPanel></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Minimize_Click" ToolTip="{v:L 'Réduire la fenêtre', 'Minimize the window'}" AutomationProperties.Name="{v:L 'Réduire la fenêtre', 'Minimize the window'}"><v:Icon Kind="minus" Width="16" Height="16"/></Button><Button x:Name="MaximizeButton" Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Maximize_Click" ToolTip="{v:L 'Agrandir la fenêtre', 'Maximize the window'}" AutomationProperties.Name="{v:L 'Agrandir la fenêtre', 'Maximize the window'}"><v:Icon x:Name="MaximizeIcon" Kind="maximize" Width="15" Height="15"/></Button><Button Width="46" Height="32" Padding="0" Style="{StaticResource CaptionClose}" Click="Close_Click" ToolTip="{v:L 'Fermer Mira', 'Close Mira'}" AutomationProperties.Name="{v:L 'Fermer Mira', 'Close Mira'}"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel></Grid>
  <Border x:Name="Notice" Grid.RowSpan="2" Panel.ZIndex="90" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="760" Margin="80,0,30,25" Padding="17,10,8,10" Background="{StaticResource Toast}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="8"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Click="DismissNotice_Click" ToolTip="{v:L 'Masquer', 'Hide'}" AutomationProperties.Name="{v:L 'Masquer le message', 'Hide the message'}"><v:Icon Kind="close" Width="15" Height="15"/></Button><Button x:Name="NoticeAction" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource Primary}" Padding="13,6" FontSize="12" Margin="4,0,6,0" VerticalAlignment="Center" Click="NoticeAction_Click"/><TextBlock x:Name="NoticeText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 </Grid>
</Window>
