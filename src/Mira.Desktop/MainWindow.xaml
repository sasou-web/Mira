       <TextBlock x:Name="SleepStatus" Margin="10,2,10,8" FontSize="12" Foreground="{DynamicResource Muted}" v:Accessible.Announce="Polite"/>
       <StackPanel x:Name="TogetherSection" Visibility="Collapsed"><TextBlock Text="{v:L 'REGARDER ENSEMBLE', 'WATCH TOGETHER'}" Style="{StaticResource PlayerMenuHeading}"/><DockPanel Margin="10,0,6,8"><Button DockPanel.Dock="Right" Content="{v:L 'Quitter', 'Leave'}" MinWidth="70" Style="{StaticResource PlayerMenuChip}" Margin="0" Click="TogetherLeave_Click" AutomationProperties.Name="{v:L 'Quitter le groupe', 'Leave the group'}"/><TextBlock x:Name="TogetherStatus" FontSize="13" Foreground="{StaticResource TextBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></StackPanel>
       <Border Height="1" Background="{StaticResource Wash}" Margin="10,2,10,6"/>
       <DockPanel Margin="10,0,6,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="−" Tag="-0.5" Width="32" Style="{StaticResource PlayerMenuChip}" Margin="0" Click="SubtitleDelay_Click" ToolTip="{v:L 'Sous-titres 0,5 s plus tôt', 'Subtitles 0.5 s earlier'}" AutomationProperties.Name="{v:L 'Sous-titres 0,5 seconde plus tôt', 'Subtitles half a second earlier'}"/><Button x:Name="SubtitleDelayReset" Content="{v:L '0,0 s', '0.0 s'}" Tag="0" MinWidth="58" Style="{StaticResource PlayerMenuChip}" Click="SubtitleDelay_Click" ToolTip="{v:L 'Réinitialiser le décalage', 'Reset the delay'}" AutomationProperties.Name="{v:L 'Réinitialiser le décalage des sous-titres', 'Reset the subtitle delay'}"/><Button Content="+" Tag="0.5" Width="32" Style="{StaticResource PlayerMenuChip}" Margin="0" Click="SubtitleDelay_Click" ToolTip="{v:L 'Sous-titres 0,5 s plus tard', 'Subtitles 0.5 s later'}" AutomationProperties.Name="{v:L 'Sous-titres 0,5 seconde plus tard', 'Subtitles half a second later'}"/></StackPanel><TextBlock Text="{v:L 'Décalage des sous-titres', 'Subtitle delay'}" FontSize="13" Foreground="{StaticResource TextBody}" VerticalAlignment="Center"/></DockPanel>
       <Border Height="1" Background="{StaticResource Wash}" Margin="10,6,10,2"/>
       <TextBlock Text="{v:L 'INFORMATIONS', 'INFO'}" Style="{StaticResource PlayerMenuHeading}"/>
       <TextBlock x:Name="PlaybackInfo" Margin="10,0,10,8" FontSize="12" Foreground="{StaticResource TextTertiary}" LineHeight="19" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Border>
   </Popup>
