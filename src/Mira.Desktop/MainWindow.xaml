      <Button x:Name="WelcomeInstall" Style="{StaticResource Primary}" Click="WelcomeInstall_Click" Padding="20,14" Margin="6" v:Motion.Radius="12" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Installer Jellyfin" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Sur ce PC, en quelques minutes." FontSize="12" FontWeight="Normal" Opacity="0.72" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Button>
      <Button x:Name="WelcomeConnect" Click="WelcomeConnect_Click" Padding="20,14" Margin="6" v:Motion.Radius="12" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="Me connecter" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="J’ai déjà un serveur Jellyfin." FontSize="12" FontWeight="Normal" Opacity="0.72" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Button>
     </UniformGrid>
     <Button Content="Essayer la démo" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="WelcomeDemo_Click"/>
    </StackPanel>
   </Viewbox>
  </Grid>
  <Grid x:Name="WhatsNewOverlay" Grid.RowSpan="2" Panel.ZIndex="75" Visibility="Collapsed" Background="#F4070708" KeyboardNavigation.TabNavigation="Cycle">
   <Viewbox Margin="28,44,28,24" Stretch="Uniform" StretchDirection="DownOnly" TextOptions.TextFormattingMode="Ideal">
    <Border x:Name="WhatsNewCard" Width="600" Padding="38,34" Background="#F2101012" BorderBrush="#29292D" BorderThickness="1" CornerRadius="20">
     <StackPanel>
      <StackPanel Orientation="Horizontal"><v:Icon Kind="sparkle" Width="16" Height="16" Foreground="#C9C9CF"/><TextBlock Text="NOUVEAUTÉS" FontSize="11" FontWeight="SemiBold" Foreground="#C9C9CF" Margin="8,1,0,0"/></StackPanel>
      <TextBlock x:Name="WhatsNewTitle" FontSize="32" FontWeight="Bold" Margin="0,10,0,6"/>
      <TextBlock x:Name="WhatsNewSummary" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
      <StackPanel x:Name="WhatsNewItems" Margin="0,22,0,0"/>
      <DockPanel Margin="0,18,0,0"><Button x:Name="WhatsNewDone" DockPanel.Dock="Right" Style="{StaticResource Primary}" v:Motion.Radius="9" Content="C’est parti" Padding="26,11" Click="WhatsNewDone_Click"/><Button x:Name="WhatsNewDetails" Style="{StaticResource Quiet}" Content="Tous les détails" HorizontalAlignment="Left" Click="WhatsNewDetails_Click"/></DockPanel>
     </StackPanel>
    </Border>
   </Viewbox>
  </Grid>
  <Grid x:Name="TitleBar" Panel.ZIndex="80" Background="Transparent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Minimize_Click" ToolTip="Réduire la fenêtre" AutomationProperties.Name="Réduire la fenêtre"><v:Icon Kind="minus" Width="16" Height="16"/></Button><Button x:Name="MaximizeButton" Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Maximize_Click" ToolTip="Agrandir la fenêtre" AutomationProperties.Name="Agrandir la fenêtre"><v:Icon x:Name="MaximizeIcon" Kind="maximize" Width="15" Height="15"/></Button><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Close_Click" ToolTip="Fermer Mira" AutomationProperties.Name="Fermer Mira"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel></Grid>
  <Border x:Name="Notice" Grid.RowSpan="2" Panel.ZIndex="90" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="760" Margin="80,0,30,25" Padding="17,10,8,10" Background="#F0222227" BorderBrush="#43434A" BorderThickness="1" CornerRadius="8"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" Click="DismissNotice_Click" ToolTip="Masquer" AutomationProperties.Name="Masquer le message"><v:Icon Kind="close" Width="15" Height="15"/></Button><Button x:Name="NoticeAction" DockPanel.Dock="Right" Visibility="Collapsed" Style="{StaticResource Primary}" Padding="13,6" FontSize="12" Margin="4,0,6,0" VerticalAlignment="Center" Click="NoticeAction_Click"/><TextBlock x:Name="NoticeText" VerticalAlignment="Center" FontSize="12" Foreground="#DDDEE4" TextWrapping="Wrap" Margin="0,0,10,0"/></DockPanel></Border>
 </Grid>
</Window>
