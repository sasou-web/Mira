       <StackPanel Grid.Column="1" MinWidth="196" MaxWidth="270"><TextBlock Text="{v:L 'SOUS-TITRES', 'SUBTITLES'}" Style="{StaticResource PlayerMenuHeading}"/><ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SubtitleTrackList" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer><Border Height="1" Background="{StaticResource Wash}" Margin="10,5"/><Button Style="{StaticResource PlayerMenuItem}" Click="LoadSubtitle_Click" AutomationProperties.Name="{v:L 'Charger un fichier de sous-titres', 'Load a subtitle file'}"><DockPanel><v:Icon Kind="plus" Width="15" Height="15" Margin="1,0,11,0" Foreground="{StaticResource TextBody}"/><TextBlock Text="{v:L 'Charger un fichier…', 'Load a file…'}" VerticalAlignment="Center"/></DockPanel></Button><Button x:Name="SubtitleSearchButton" Style="{StaticResource PlayerMenuItem}" Click="SubtitleSearch_Click" Visibility="Collapsed" AutomationProperties.Name="{v:L 'Chercher des sous-titres avec Jellyfin', 'Search for subtitles with Jellyfin'}"><DockPanel><v:Icon Kind="search" Width="15" Height="15" Margin="1,0,11,0" Foreground="{StaticResource TextBody}"/><TextBlock Text="{v:L 'Chercher des sous-titres…', 'Search for subtitles…'}" VerticalAlignment="Center"/></DockPanel></Button></StackPanel>
      </Grid>
      <!-- The season of the episode playing (a slice of a long one: EpisodePages), with the others a step away. -->
      <StackPanel x:Name="EpisodesMenu" Width="420" Visibility="Collapsed">
       <DockPanel Margin="4,0,4,4"><Button x:Name="EpisodePageBack" DockPanel.Dock="Left" Style="{StaticResource PlayerMenuChip}" Width="34" Margin="0" Click="EpisodePage_Click" Tag="-1" ToolTip="{v:L 'Saison précédente', 'Previous season'}" AutomationProperties.Name="{v:L 'Saison précédente', 'Previous season'}"><v:Icon Kind="back" Width="15" Height="15"/></Button><Button x:Name="EpisodePageNext" DockPanel.Dock="Right" Style="{StaticResource PlayerMenuChip}" Width="34" Margin="0" Click="EpisodePage_Click" Tag="1" ToolTip="{v:L 'Saison suivante', 'Next season'}" AutomationProperties.Name="{v:L 'Saison suivante', 'Next season'}"><v:Icon Kind="next" Width="15" Height="15"/></Button><TextBlock x:Name="EpisodePageLabel" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" v:Accessible.Announce="Polite"/></DockPanel>
       <ScrollViewer x:Name="EpisodeListScroll" MaxHeight="400" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="EpisodeList" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </StackPanel>
