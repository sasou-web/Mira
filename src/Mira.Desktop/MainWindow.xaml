     <Button x:Name="SkipButton" Style="{StaticResource PlayerPill}" Visibility="Collapsed" Click="Skip_Click" AutomationProperties.Name="{v:L 'Passer le passage', 'Skip this part'}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SkipText" Text="{v:L 'Passer l’opening', 'Skip intro'}" VerticalAlignment="Center"/><v:Icon Kind="skip" Width="16" Height="16" Margin="11,0,0,0"/></StackPanel></Button>
    </StackPanel>
    <!-- « Regarder ensemble »: what the group is doing, top center (UpdateGroupPill). -->
    <Border x:Name="GroupPill" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="120,44,120,0" Padding="13,8,16,8" CornerRadius="18" Background="{StaticResource Pill}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
     <StackPanel Orientation="Horizontal"><v:Icon Kind="users" Width="16" Height="16" Foreground="White" VerticalAlignment="Center"/><TextBlock x:Name="GroupPillText" Foreground="White" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" v:Accessible.Announce="Polite"/></StackPanel>
    </Border>
    <Border x:Name="MiniOutline" Visibility="Collapsed" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"/>
    <Grid x:Name="PlayerWindowChrome" Height="34" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="PlayerChrome_MouseDown">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Minimize_Click" ToolTip="{v:L 'Réduire la fenêtre', 'Minimize the window'}" AutomationProperties.Name="{v:L 'Réduire la fenêtre', 'Minimize the window'}"><v:Icon Kind="minus" Width="16" Height="16"/></Button><Button x:Name="PlayerMaximizeButton" Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Maximize_Click" ToolTip="{v:L 'Agrandir la fenêtre', 'Maximize the window'}" AutomationProperties.Name="{v:L 'Agrandir la fenêtre', 'Maximize the window'}"><v:Icon x:Name="PlayerMaximizeIcon" Kind="maximize" Width="15" Height="15"/></Button><Button Width="46" Height="32" Padding="0" Style="{StaticResource CaptionClose}" Click="Close_Click" ToolTip="{v:L 'Fermer Mira', 'Close Mira'}" AutomationProperties.Name="{v:L 'Fermer Mira', 'Close Mira'}"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel>
    </Grid>
    </Grid>
    </AdornerDecorator>
   </playback:PlayerOverlay>
   <Popup x:Name="PlayerOptionsPopup" PlacementTarget="{Binding ElementName=PlayerShell}" Placement="Custom" AllowsTransparency="True" StaysOpen="False" Opened="PlayerOptions_Opened" Closed="PlayerOptions_Closed">
