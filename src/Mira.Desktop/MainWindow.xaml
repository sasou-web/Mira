 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" Icon="Assets/mira.ico" Title="Mira" Width="1480" Height="930" MinWidth="960" MinHeight="600" Background="#070708" Foreground="#F4F4F5" FontFamily="{StaticResource AppFont}" FontSize="14" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" PreviewKeyDown="Player_PreviewKeyDown" KeyDown="Window_KeyDown" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="1"/></shell:WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="LibraryShell" Grid.RowSpan="2">
   <ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" v:SmoothScroll.Enabled="True" x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Library_Scrolled">
