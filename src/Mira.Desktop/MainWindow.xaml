       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Langue audio préférée', 'Preferred audio language'}" FontWeight="SemiBold" Margin="0,0,0,13"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="AudioLanguageChoice" SelectionChanged="LanguageChoice_Changed" AutomationProperties.Name="{v:L 'Langue audio préférée', 'Preferred audio language'}"><ComboBoxItem Content="{v:L 'Japonais, puis français', 'Japanese, then French'}" Tag="jpn,ja,fre,fra,fr,eng,en"/><ComboBoxItem Content="{v:L 'Japonais, puis anglais', 'Japanese, then English'}" Tag="jpn,ja,eng,en,fre,fra,fr"/><ComboBoxItem Content="{v:L 'Français, puis anglais', 'French, then English'}" Tag="fre,fra,fr,eng,en"/><ComboBoxItem Content="{v:L 'Anglais, puis français', 'English, then French'}" Tag="eng,en,fre,fra,fr"/><ComboBoxItem Content="{v:L 'Ordre personnalisé', 'Custom order'}" Tag="custom"/></ComboBox></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Langue des sous-titres', 'Subtitle language'}" FontWeight="SemiBold" Margin="0,0,0,13"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="SubtitleLanguageChoice" SelectionChanged="LanguageChoice_Changed" AutomationProperties.Name="{v:L 'Langue des sous-titres', 'Subtitle language'}"><ComboBoxItem Content="{v:L 'Français, puis anglais', 'French, then English'}" Tag="fre,fra,fr,eng,en"/><ComboBoxItem Content="{v:L 'Anglais, puis français', 'English, then French'}" Tag="eng,en,fre,fra,fr"/><ComboBoxItem Content="{v:L 'Anglais', 'English'}" Tag="eng,en"/><ComboBoxItem Content="{v:L 'Japonais', 'Japanese'}" Tag="jpn,ja"/><ComboBoxItem Content="{v:L 'Ordre personnalisé', 'Custom order'}" Tag="custom"/></ComboBox><TextBlock Text="{v:L 'Les langues sont choisies parmi les pistes présentes dans le fichier. Tu peux les changer pendant la lecture.', 'Languages are picked from the tracks in the file. You can change them during playback.'}" Style="{StaticResource SettingDescription}"/></StackPanel></Border>
       <Border x:Name="CustomLanguages" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Codes de langues, par ordre de préférence', 'Language codes, in order of preference'}" Margin="0,0,0,12"/><TextBlock Text="Audio" Style="{StaticResource SettingDescription}"/><TextBox x:Name="AudioLanguageBox" Margin="0,8,0,12" AutomationProperties.Name="{v:L 'Codes des langues audio, par ordre de préférence', 'Audio language codes, in order of preference'}"/><TextBlock Text="{v:L 'Sous-titres', 'Subtitles'}" Style="{StaticResource SettingDescription}"/><TextBox x:Name="SubtitleLanguageBox" Margin="0,8,0,0" AutomationProperties.Name="{v:L 'Codes des langues des sous-titres, par ordre de préférence', 'Subtitle language codes, in order of preference'}"/></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><DockPanel><TextBlock x:Name="SubtitleSizeLabel" DockPanel.Dock="Right" Foreground="{StaticResource TextBody}"/><TextBlock Text="{v:L 'Taille et style des sous-titres', 'Subtitle size and style'}" FontWeight="SemiBold"/></DockPanel><Slider x:Name="SubtitleSizeSlider" AutomationProperties.Name="{v:L 'Taille des sous-titres', 'Subtitle size'}" Minimum="20" Maximum="70" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,17,0,12" ValueChanged="SubtitleSize_Changed"/><Grid Height="165" ClipToBounds="True" Background="{StaticResource Raised}"><Image x:Name="SubtitlePreviewImage" Stretch="UniformToFill" Opacity="0.48"/><Border Background="#44000000"/><Border x:Name="SubtitlePreviewBox" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,27"><TextBlock x:Name="SubtitlePreview" Text="{v:L 'Encore un épisode ?', 'One more episode?'}" FontWeight="SemiBold" FontSize="26" TextAlignment="Center" TextWrapping="Wrap"><TextBlock.Effect><DropShadowEffect Color="Black" ShadowDepth="1" BlurRadius="4" Opacity="1"/></TextBlock.Effect></TextBlock></Border></Grid>
        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{v:L 'Couleur', 'Color'}" Foreground="{StaticResource TextBody}" Margin="0,0,0,8"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="SubtitleColorChoice" SelectionChanged="SubtitleStyle_Changed" AutomationProperties.Name="{v:L 'Couleur des sous-titres', 'Subtitle color'}"><ComboBoxItem Content="{v:L 'Blanc', 'White'}" Tag="White"/><ComboBoxItem Content="{v:L 'Jaune', 'Yellow'}" Tag="Yellow"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{v:L 'Hauteur à l’écran', 'Height on screen'}" Foreground="{StaticResource TextBody}" Margin="0,0,0,8"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="SubtitleHeightChoice" SelectionChanged="SubtitleStyle_Changed" AutomationProperties.Name="{v:L 'Hauteur des sous-titres à l’écran', 'Subtitle height on screen'}"/></StackPanel></Grid>
        <DockPanel Margin="0,18,0,0"><CheckBox x:Name="SubtitleBackgroundCheck" DockPanel.Dock="Right" Click="SubtitleStyle_Changed" AutomationProperties.Name="{v:L 'Fond sombre derrière les sous-titres', 'Dark background behind subtitles'}"/><StackPanel><TextBlock Text="{v:L 'Fond sombre', 'Dark background'}"/><TextBlock Text="{v:L 'Un bandeau derrière le texte, lisible même sur une scène claire.', 'A band behind the text, readable even on a bright scene.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel>
        <DockPanel Margin="0,14,0,0"><CheckBox x:Name="SubtitleBoldCheck" DockPanel.Dock="Right" Click="SubtitleStyle_Changed" AutomationProperties.Name="{v:L 'Sous-titres en gras', 'Bold subtitles'}"/><TextBlock Text="{v:L 'Texte en gras', 'Bold text'}" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="{v:L 'Aperçu indicatif. Taille, couleur, fond et gras valent pour les sous-titres simples (SRT, WebVTT…) : les sous-titres stylés des animés (ASS) gardent leur mise en forme, seule la hauteur remonte leurs dialogues.', 'Approximate preview. Size, color, background and bold apply to plain subtitles (SRT, WebVTT…): anime’s styled subtitles (ASS) keep their look, and only the height raises their dialogue.'}" Style="{StaticResource SettingDescription}" Margin="0,16,30,0"/></StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="AppearanceSettings" Visibility="Collapsed"><Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Langue', 'Language'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Celle des menus et des messages de Mira. Elle change quand Mira s’ouvre de nouveau.', 'For Mira’s menus and messages. It changes when Mira opens again.'}" Style="{StaticResource SettingDescription}" Margin="0,8,0,16"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="MiraLanguageChoice" AutomationProperties.Name="{v:L 'Langue de Mira', 'Mira’s language'}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Français" Tag="fr"/></ComboBox></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="HeroAutoPlayCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Carrousel automatique', 'Automatic carousel'}"/><StackPanel><TextBlock Text="{v:L 'Animer l’accueil', 'Animate Home'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Changer de titre toutes les 6,5 secondes. La rotation s’interrompt pendant tes interactions.', 'Change title every 6.5 seconds. The rotation pauses while you interact.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Rangées de l’accueil', 'Home rows'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Choisis les rangées de l’accueil et leur ordre. « Nouveau dans … » montre les derniers titres d’une de tes bibliothèques. La grille « Ajoutés récemment », qui se prolonge, reste en bas.', 'Choose Home’s rows and their order. “New in …” shows the latest titles of one of your libraries. The “Recently added” grid, which keeps going, stays at the bottom.'}" Style="{StaticResource SettingDescription}"/><StackPanel x:Name="HomeRowsList" Margin="0,14,0,0"/><Button Content="{v:L 'Revenir à l’ordre de Mira', 'Back to Mira’s order'}" Style="{StaticResource Quiet}" Click="HomeRowsReset_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Densité de la bibliothèque', 'Library density'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Choisir la place accordée aux affiches et aux titres.', 'Choose how much room posters and titles get.'}" Style="{StaticResource SettingDescription}" Margin="0,8,0,16"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="DensityChoice" AutomationProperties.Name="{v:L 'Densité de la bibliothèque', 'Library density'}"><ComboBoxItem Content="{v:L 'Confortable · grandes affiches', 'Comfortable · large posters'}" Tag="Comfortable"/><ComboBoxItem Content="{v:L 'Compacte · davantage de titres', 'Compact · more titles'}" Tag="Compact"/></ComboBox></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="ShowProgressCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Afficher la progression', 'Show progress'}"/><StackPanel><TextBlock Text="{v:L 'Progression sur les affiches', 'Progress on posters'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Repérer les titres commencés grâce à une barre discrète.', 'Spot started titles with a subtle bar.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="ReduceMotionCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Réduire les animations', 'Reduce animations'}"/><StackPanel><TextBlock Text="{v:L 'Réduire les animations', 'Reduce animations'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Réduire les transitions, le défilement progressif et la rotation automatique de l’accueil. Mira les réduit aussi quand les effets d’animation de Windows sont désactivés.', 'Reduce transitions, smooth scrolling and Home’s automatic rotation. Mira also reduces them when Windows’ animation effects are off.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
      </StackPanel>
      <StackPanel x:Name="ServerSettings" Visibility="Collapsed">
       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock x:Name="ServerLabel" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SettingsServerAddress" Style="{StaticResource SettingDescription}"/><TextBlock x:Name="SyncLabel" Foreground="{StaticResource Success}" Margin="0,22,0,20"/><WrapPanel><Button Content="{v:L 'Synchroniser maintenant', 'Sync now'}" Click="SyncNow_Click" Margin="0,0,10,8"/><Button x:Name="SettingsOpenJellyfin" Content="{v:L 'Ouvrir Jellyfin dans le navigateur', 'Open Jellyfin in the browser'}" Click="OpenJellyfin_Click" Margin="0,0,10,8"/><Button Content="{v:L 'Gérer mon compte', 'Manage my account'}" Click="Account_Click" Style="{StaticResource Quiet}" Margin="0,0,10,8"/><Button Content="{v:L 'Guide de démarrage', 'Getting started'}" Click="Guide_Click" Style="{StaticResource Quiet}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="EpisodeNoticesCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Prévenir des nouveaux épisodes', 'Notify me of new episodes'}"/><StackPanel><TextBlock Text="{v:L 'Prévenir des nouveaux épisodes', 'Notify me of new episodes'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Une notification de Windows quand un épisode d’une série que tu regardes, ou que tu as mise en favori, arrive sur Jellyfin. Tant que Mira est ouvert, même réduit.', 'A Windows notification when an episode of a show you watch, or added to your favorites, arrives on Jellyfin. While Mira is open, even minimized.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
       <!-- Who plays what on Jellyfin, refreshed while this tab shows (MainWindow.Viewers.cs). -->
       <Border x:Name="ViewersRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'En ce moment sur Jellyfin', 'Now on Jellyfin'}" FontWeight="SemiBold"/><TextBlock x:Name="ViewersStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/><StackPanel x:Name="ViewersPanel"/></StackPanel></Border>
       <!-- « Ajouter un ami »: shown to an administrator (MainWindow.Friends.cs): an account that sees only the libraries chosen. -->
       <Border x:Name="FriendRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Ajouter un ami', 'Add a friend'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Crée-lui son propre compte sur ton Jellyfin, pour regarder ensemble ou de son côté. Il ne voit que les bibliothèques que tu choisis, ne peut rien télécharger ni rien changer, et son nom n’apparaît pas sur l’écran de connexion.', 'Create their own account on your Jellyfin, to watch together or on their own. They only see the libraries you choose, can’t download or change anything, and their name doesn’t appear on the sign-in screen.'}" Style="{StaticResource SettingDescription}"/>
        <StackPanel x:Name="FriendForm"><TextBlock Text="{v:L 'Son prénom', 'Their first name'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,7"/><TextBox x:Name="FriendNameBox" Width="260" HorizontalAlignment="Left" MaxLength="40" KeyDown="FriendName_KeyDown" AutomationProperties.Name="{v:L 'Prénom de ton ami', 'Your friend’s first name'}"/><TextBlock Text="{v:L 'Ce qu’il pourra regarder', 'What they can watch'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,3"/><StackPanel x:Name="FriendLibraries" MaxWidth="460" HorizontalAlignment="Left"/><Button x:Name="FriendCreateButton" Content="{v:L 'Créer son compte', 'Create their account'}" Click="FriendCreate_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel>
        <StackPanel x:Name="FriendDone" Visibility="Collapsed"><TextBlock x:Name="FriendDoneTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,30,0"/><TextBlock x:Name="FriendDoneText" Style="{StaticResource SettingDescription}"/>
         <DockPanel x:Name="FriendPasswordPanel" Visibility="Collapsed" Margin="0,14,0,0" HorizontalAlignment="Left"><Button Content="{v:L 'Copier', 'Copy'}" DockPanel.Dock="Right" Click="FriendPasswordCopy_Click" Margin="10,0,0,0" AutomationProperties.Name="{v:L 'Copier son mot de passe', 'Copy their password'}"/><TextBox x:Name="FriendPasswordBox" IsReadOnly="True" Width="260" FontSize="15" FontWeight="SemiBold" AutomationProperties.Name="{v:L 'Son mot de passe', 'Their password'}"/></DockPanel>
         <WrapPanel Margin="0,14,0,0"><Button x:Name="FriendApproveButton" Content="{v:L 'Autoriser son téléphone', 'Allow their phone'}" Click="FriendApprove_Click" Margin="0,0,10,8"/><Button x:Name="FriendPasswordButton" Content="{v:L 'Montrer son mot de passe', 'Show their password'}" Style="{StaticResource Quiet}" Click="FriendPassword_Click" Margin="0,0,10,8"/><Button Content="{v:L 'Ajouter un autre ami', 'Add another friend'}" Style="{StaticResource Quiet}" Click="FriendAgain_Click" Margin="0,0,0,8"/></WrapPanel>
         <TextBlock Text="{v:L 'Pas chez toi ? Il lui faut aussi Tailscale, et ce PC partagé avec lui : sur la page de Tailscale, Machines → … à côté de ce PC → Share. Il accepte avec son compte Tailscale gratuit.', 'Not at your home? They also need Tailscale, and this PC shared with them: on Tailscale’s page, Machines → … next to this PC → Share. They accept with their free Tailscale account.'}" Style="{StaticResource SettingDescription}"/><Button Content="{v:L 'Ouvrir Tailscale', 'Open Tailscale'}" Style="{StaticResource Quiet}" Click="FriendTailscale_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
        <TextBlock x:Name="FriendStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <!-- « Inviter par lien »: shown to an administrator (MainWindow.GuestLinks.cs): a link for a guest without an account, through Tailscale Funnel. -->
       <Border x:Name="GuestRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Liens d’invités', 'Guest links'}" FontWeight="SemiBold"/><TextBlock x:Name="GuestRules" Style="{StaticResource SettingDescription}"/>
        <StackPanel x:Name="GuestFunnelPanel" Visibility="Collapsed"><TextBlock x:Name="GuestFunnelText" Style="{StaticResource SettingDescription}"/><WrapPanel Margin="0,14,0,0"><Button x:Name="GuestFunnelButton" Content="{v:L 'Ouvrir Mira à Internet', 'Open Mira to the Internet'}" Click="GuestFunnel_Click" Margin="0,0,10,8"/><Button x:Name="GuestEnableButton" Content="{v:L 'Autoriser Funnel sur Tailscale', 'Allow Funnel on Tailscale'}" Style="{StaticResource Quiet}" Visibility="Collapsed" Click="GuestEnable_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel>
        <StackPanel x:Name="GuestAddressPanel" Visibility="Collapsed"><TextBlock Text="{v:L 'Pour qu’un lien marche depuis Internet, ouvre Mira au monde par Tailscale Funnel sur le PC de Jellyfin, dans PowerShell :', 'For a link to work from the Internet, open Mira to the world with Tailscale Funnel on the Jellyfin PC, in PowerShell:'}" Style="{StaticResource SettingDescription}"/><DockPanel Margin="0,10,0,0" HorizontalAlignment="Left"><Button Content="{v:L 'Copier', 'Copy'}" DockPanel.Dock="Right" Click="GuestCommandCopy_Click" Margin="10,0,0,0" AutomationProperties.Name="{v:L 'Copier la commande', 'Copy the command'}"/><TextBox x:Name="GuestCommandBox" IsReadOnly="True" Width="460" AutomationProperties.Name="{v:L 'Commande de Funnel', 'Funnel command'}"/></DockPanel>
         <TextBlock Text="{v:L 'Funnel n’ouvre que Mira, jamais le reste de Jellyfin. Écris ici l’adresse qu’il affiche :', 'Funnel only opens Mira, never the rest of Jellyfin. Type the address it shows here:'}" Style="{StaticResource SettingDescription}"/><DockPanel Margin="0,10,0,0" HorizontalAlignment="Left"><Button x:Name="GuestAddressSave" Content="{v:L 'Enregistrer', 'Save'}" DockPanel.Dock="Right" Click="GuestAddressSave_Click" Margin="10,0,0,0"/><TextBox x:Name="GuestAddressBox" Width="340" KeyDown="GuestAddress_KeyDown" AutomationProperties.Name="{v:L 'Adresse publique de Mira', 'Mira’s public address'}"/></DockPanel></StackPanel>
        <StackPanel x:Name="GuestForm" Visibility="Collapsed"><TextBlock Text="{v:L 'Son prénom', 'Their first name'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,7"/><DockPanel HorizontalAlignment="Left"><Button x:Name="GuestCreateButton" Content="{v:L 'Créer le lien', 'Create the link'}" DockPanel.Dock="Right" Click="GuestCreate_Click" Margin="10,0,0,0"/><TextBox x:Name="GuestNameBox" Width="260" MaxLength="40" KeyDown="GuestName_KeyDown" AutomationProperties.Name="{v:L 'Prénom de ton invité', 'Your guest’s first name'}"/></DockPanel></StackPanel>
        <StackPanel x:Name="GuestMade" Visibility="Collapsed"><TextBlock x:Name="GuestMadeText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,30,0"/><DockPanel Margin="0,10,0,0" HorizontalAlignment="Left"><Button x:Name="GuestCopyButton" Content="{v:L 'Copier le lien', 'Copy the link'}" DockPanel.Dock="Right" Click="GuestCopy_Click" Margin="10,0,0,0"/><TextBox x:Name="GuestLinkBox" IsReadOnly="True" Width="460" AutomationProperties.Name="{v:L 'Lien de l’invité', 'Guest’s link'}"/></DockPanel><Button Content="{v:L 'Un autre lien', 'Another link'}" Style="{StaticResource Quiet}" Click="GuestAgain_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
        <StackPanel x:Name="GuestList"/>
        <DockPanel x:Name="GuestAddressLine" Visibility="Collapsed" Margin="0,14,0,0"><Button Content="{v:L 'Changer', 'Change'}" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Click="GuestAddressChange_Click" VerticalAlignment="Top" AutomationProperties.Name="{v:L 'Changer l’adresse des liens', 'Change the address of the links'}"/><TextBlock x:Name="GuestAddressText" Style="{StaticResource SettingDescription}" Margin="0"/></DockPanel>
        <TextBlock x:Name="GuestStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <!-- « Lecture impossible » reports sent by Mira web, for an administrator, while there are some (MainWindow.Failures.cs). -->
       <Border x:Name="FailuresRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Lectures impossibles signalées', 'Reported playback failures'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Quand un titre refuse de se lire sur un téléphone, « Envoyer le détail à Jellyfin » le range ici : ce que contient le fichier et ce que Mira a essayé. « Copier » le met dans le presse-papiers, pour le donner à qui t’aide. Jellyfin les garde quelques jours, avec ses journaux.', 'When a title won’t play on a phone, “Send the details to Jellyfin” puts it here: what the file contains and what Mira tried. “Copy” puts it on the clipboard, to give to whoever helps you. Jellyfin keeps them a few days, with its logs.'}" Style="{StaticResource SettingDescription}"/><StackPanel x:Name="FailuresPanel"/></StackPanel></Border>
       <!-- « Titres à corriger »: shown to an administrator while Jellyfin has some (MainWindow.Identify.cs). -->
       <Border x:Name="FixRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Titres à corriger', 'Titles to fix'}" FontWeight="SemiBold"/><TextBlock x:Name="FixStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/><StackPanel x:Name="FixPanel"/><Button x:Name="FixMore" Style="{StaticResource Quiet}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0" Click="FixMore_Click"/><TextBlock Text="{v:L '« Non reconnu » : Jellyfin n’a trouvé ce titre sur aucune de ses sources (TMDb…). Souvent un nom de dossier abîmé, ou un titre romaji. « Identifier » te laisse choisir le bon ; un titre en double est peut-être rangé deux fois.', '“Not recognized”: Jellyfin didn’t find this title in any of its sources (TMDb…). Often a mangled folder name, or a romaji title. “Identify” lets you choose the right one; a duplicate title may be filed twice.'}" Style="{StaticResource SettingDescription}" Margin="0,14,30,0"/></StackPanel></Border>
       <!-- Quick Connect: shown once Jellyfin says it lets devices in by a code (ShowApproveDeviceAsync); an administrator picks the account. -->
       <Border x:Name="ApproveDeviceRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Autoriser un appareil', 'Allow a device'}" FontWeight="SemiBold"/><TextBlock x:Name="ApproveDeviceText" Text="{v:L 'Sur ton téléphone, « Se connecter avec un code » affiche 6 chiffres : saisis-les ici pour le connecter à ton compte, sans y taper ton mot de passe. N’autorise qu’un appareil que tu as sous les yeux.', 'On your phone, “Sign in with a code” shows 6 digits: enter them here to sign it in to your account, without typing your password there. Only allow a device you have in front of you.'}" Style="{StaticResource SettingDescription}"/><DockPanel Margin="0,16,0,0" HorizontalAlignment="Left"><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="ApproveAccount" DockPanel.Dock="Left" Width="200" Margin="0,0,10,0" Visibility="Collapsed" AutomationProperties.Name="{v:L 'Compte auquel connecter l’appareil', 'Account to sign the device in to'}"/><Button x:Name="ApproveDeviceButton" DockPanel.Dock="Right" Content="{v:L 'Autoriser', 'Allow'}" Click="ApproveDevice_Click" Margin="10,0,0,0"/><TextBox x:Name="ApproveCodeBox" Width="150" Height="38" FontSize="16" MaxLength="7" InputScope="Number" KeyDown="ApproveCode_KeyDown" AutomationProperties.Name="{v:L 'Code de l’appareil à autoriser', 'Code of the device to allow'}"/></DockPanel><TextBlock x:Name="ApproveDeviceStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <!-- Sagas: shown to an administrator whose Jellyfin can gather films into sagas (ShowSagasAsync). -->
       <Border x:Name="SagasRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Sagas de films', 'Movie collections'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'La fiche d’un film montre les autres films de sa saga (« Harry Potter - Saga ») quand Jellyfin les range ensemble. Il le fait à chaque analyse de la bibliothèque, d’après TMDb, dès que deux films d’une même saga y sont.', 'A movie’s page shows the other movies of its collection (“Harry Potter - Collection”) when Jellyfin groups them. It does so at each library scan, from TMDb, as soon as two movies of the same collection are there.'}" Style="{StaticResource SettingDescription}"/><Button x:Name="SagasButton" Content="{v:L 'Ranger mes films en sagas', 'Group my movies into collections'}" Click="Sagas_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock x:Name="SagasStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <Border x:Name="TrickplayRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Aperçus de la barre de lecture', 'Seek bar previews'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'En survolant la barre du lecteur, l’image du moment visé, sur PC, Mac et téléphone. Jellyfin les prépare pour chaque film et épisode, en fond : la première fois, son processeur est occupé un long moment (des heures pour une grande bibliothèque), puis chaque nuit pour les nouveaux titres. Elles prennent un peu de place à côté de ses fichiers.', 'Hovering over the player’s bar shows the picture at that moment, on PC, Mac and phone. Jellyfin prepares them for every movie and episode, in the background: the first time, its processor is busy for a long while (hours for a big library), then each night for new titles. They take a little room next to its files.'}" Style="{StaticResource SettingDescription}"/><Button x:Name="TrickplayButton" Content="{v:L 'Préparer les aperçus', 'Prepare the previews'}" Click="Trickplay_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/><TextBlock x:Name="TrickplayStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <!-- Jellyfin on this PC: its version, its backup and its update, for an administrator (MainWindow.JellyfinCare.cs). -->
       <Border x:Name="JellyfinHereRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Jellyfin sur ce PC', 'Jellyfin on this PC'}" FontWeight="SemiBold"/><TextBlock x:Name="JellyfinHereState" Style="{StaticResource SettingDescription}"/>
        <StackPanel x:Name="JellyfinUpdatePanel" Visibility="Collapsed"><TextBlock x:Name="JellyfinUpdateTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,30,0"/><TextBlock x:Name="JellyfinUpdateText" Style="{StaticResource SettingDescription}"/><WrapPanel Margin="0,14,0,0"><Button x:Name="JellyfinUpdateButton" Style="{StaticResource Primary}" Click="JellyfinUpdate_Click" Margin="0,0,10,8"/><Button Content="{v:L 'Nouveautés', 'What’s new'}" Style="{StaticResource Quiet}" Click="JellyfinNotes_Click" Margin="0,0,0,8" AutomationProperties.Name="{v:L 'Nouveautés de cette version de Jellyfin', 'What’s new in this version of Jellyfin'}"/></WrapPanel></StackPanel>
        <TextBlock Text="{v:L 'Sauvegarde', 'Backup'}" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="{v:L 'Elle garde les comptes de Jellyfin, ta progression, tes bibliothèques, leurs images et ses réglages, pas tes vidéos. Elle contient aussi les mots de passe des comptes, sous forme protégée, et les jetons de connexion de tes appareils : copie-la seulement dans un dossier à toi. Mira te la rappelle après 30 jours sans sauvegarde et en fait une avant chaque mise à jour de Jellyfin. Pour la remettre : Tableau de bord de Jellyfin → Sauvegardes.', 'It keeps Jellyfin’s accounts, your progress, your libraries, their pictures and its settings, not your videos. It also holds the accounts’ passwords, in protected form, and your devices’ sign-in tokens: only copy it to a folder of your own. Mira reminds you after 30 days without a backup and makes one before every Jellyfin update. To restore it: Jellyfin’s Dashboard → Backups.'}" Style="{StaticResource SettingDescription}"/><TextBlock x:Name="JellyfinBackupWhere" Style="{StaticResource SettingDescription}"/>
        <WrapPanel x:Name="JellyfinBackupActions" Margin="0,14,0,0"><Button x:Name="JellyfinBackupButton" Content="{v:L 'Sauvegarder maintenant', 'Back up now'}" Click="JellyfinBackup_Click" Margin="0,0,10,8"/><Button x:Name="JellyfinBackupFolderButton" Style="{StaticResource Quiet}" Click="JellyfinBackupFolder_Click" Margin="0,0,10,8"/><Button x:Name="JellyfinBackupNoCopyButton" Content="{v:L 'Ne plus copier', 'Stop copying'}" Style="{StaticResource Quiet}" Click="JellyfinBackupNoCopy_Click" Margin="0,0,10,8" AutomationProperties.Name="{v:L 'Ne plus copier les sauvegardes', 'Stop copying the backups'}"/><Button x:Name="JellyfinBackupOpenButton" Content="{v:L 'Ouvrir le dossier', 'Open the folder'}" Style="{StaticResource Quiet}" Click="JellyfinBackupOpen_Click" Margin="0,0,0,8" AutomationProperties.Name="{v:L 'Ouvrir le dossier des sauvegardes', 'Open the backups folder'}"/></WrapPanel>
        <TextBlock x:Name="JellyfinStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <!-- Graphics card: shown to an administrator of a Jellyfin on this PC, with a card it can convert on (ShowGpuAsync). -->
       <Border x:Name="GpuRow" Style="{StaticResource SettingRow}" Visibility="Collapsed"><StackPanel><TextBlock Text="{v:L 'Conversions par la carte graphique', 'Convert with the graphics card'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Quand un fichier ne se lit pas tel quel sur ton téléphone, Jellyfin le convertit pendant que tu regardes. Avec la carte graphique, la lecture démarre plus vite et le PC chauffe moins. Mira fait d’abord un essai sur un de tes titres : si la carte n’y arrive pas, rien ne change.', 'When a file doesn’t play as it is on your phone, Jellyfin converts it while you watch. With the graphics card, playback starts faster and the PC runs cooler. Mira first tries it on one of your titles: if the card can’t do it, nothing changes.'}" Style="{StaticResource SettingDescription}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="GpuButton" Content="{v:L 'Utiliser la carte graphique', 'Use the graphics card'}" Click="Gpu_Click" Margin="0,0,10,0"/><Button x:Name="GpuOffButton" Content="{v:L 'Revenir au processeur', 'Back to the processor'}" Click="GpuOff_Click" Style="{StaticResource Quiet}"/></WrapPanel><TextBlock x:Name="GpuStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite"/></StackPanel></Border>
       <TextBlock Text="{v:L 'Ta progression est enregistrée sur ce PC, puis envoyée à Jellyfin pendant la lecture. Les changements de bibliothèque sont récupérés en arrière-plan.', 'Your progress is saved on this PC, then sent to Jellyfin during playback. Library changes are fetched in the background.'}" Style="{StaticResource SettingDescription}" Margin="0,13,0,28"/><TextBlock Text="{v:L 'Bibliothèques connectées', 'Connected libraries'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><StackPanel x:Name="LibrariesPanel"/>
      </StackPanel>
      <StackPanel x:Name="TorLinkSettings" Visibility="Collapsed">
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="TorLinkAutoImportCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Ranger automatiquement dans Jellyfin', 'Sort into Jellyfin automatically'}"/><StackPanel><TextBlock Text="{v:L 'Ranger automatiquement dans Jellyfin', 'Sort into Jellyfin automatically'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Chaque téléchargement terminé rejoint Films, Séries ou Animes, nommé comme Jellyfin l’attend. Un fichier existant n’est jamais remplacé.', 'Every finished download joins Movies, Shows or Anime, named the way Jellyfin expects. An existing file is never replaced.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="TorLinkKeepSharedCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Continuer à partager dans TorLink', 'Keep sharing in TorLink'}"/><StackPanel><TextBlock Text="{v:L 'Continuer à partager dans TorLink', 'Keep sharing in TorLink'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Désactivé : le téléchargement est déplacé dans la bibliothèque, sans copie, et TorLink cesse de le partager. Activé : un lien physique le met aussi dans la bibliothèque sans prendre plus de place ; il apparaît dans les deux dossiers. Sur un autre disque, il est toujours déplacé.', 'Off: the download is moved into the library, without a copy, and TorLink stops sharing it. On: a hard link also puts it in the library without taking more room; it shows up in both folders. On another drive, it’s always moved.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><DockPanel><CheckBox x:Name="TorLinkRemoteCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Télécharger depuis tes autres appareils', 'Download from your other devices'}"/><StackPanel><TextBlock Text="{v:L 'Télécharger depuis tes autres appareils', 'Download from your other devices'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Sur le PC où tourne Jellyfin : depuis Mira web sur ton téléphone ou un autre PC (Réglages → Télécharger sur le PC serveur), cherche un titre et lance son téléchargement ici ; il est rangé dans ta bibliothèque comme les autres. Seuls les comptes administrateurs de Jellyfin peuvent en envoyer. Mira doit rester ouvert sur ce PC, même réduit : TorLink y travaille sans fenêtre.', 'On the PC that runs Jellyfin: from Mira web on your phone or another PC (Settings → Download to the server PC), search for a title and start its download here; it’s sorted into your library like the others. Only Jellyfin’s administrator accounts can send one. Mira must stay open on this PC, even minimized: TorLink works there without a window.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel><TextBlock x:Name="TorLinkRemoteStatus" Style="{StaticResource SettingDescription}" v:Accessible.Announce="Polite" Visibility="Collapsed"/><Button x:Name="TorLinkRemoteOpenButton" Content="{v:L 'Ouvrir Téléchargements', 'Open Downloads'}" Style="{StaticResource Quiet}" Click="TorLinkRemoteOpen_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"/></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Emplacement de TorLink', 'TorLink’s location'}" FontWeight="SemiBold"/><TextBlock x:Name="TorLinkPathStatus" Style="{StaticResource SettingDescription}"/><DockPanel Margin="0,14,0,0"><Button Content="{v:L 'Parcourir', 'Browse'}" DockPanel.Dock="Right" Margin="10,0,0,0" Click="BrowseTorLink_Click"/><TextBox x:Name="TorLinkPathBox" AutomationProperties.Name="{v:L 'Dossier de TorLink', 'TorLink’s folder'}"/></DockPanel></StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><StackPanel><TextBlock Text="{v:L 'Dossiers de la bibliothèque', 'Library folders'}" FontWeight="SemiBold"/><TextBlock x:Name="TorLinkFoldersStatus" Style="{StaticResource SettingDescription}"/>
        <TextBlock Text="{v:L 'Films', 'Movies'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,16,0,7"/><DockPanel><Button Content="{v:L 'Parcourir', 'Browse'}" DockPanel.Dock="Right" Margin="10,0,0,0" Tag="movies" Click="BrowseTorLinkFolder_Click"/><TextBox x:Name="TorLinkMoviesBox" AutomationProperties.Name="{v:L 'Dossier des films', 'Movies folder'}"/></DockPanel>
        <TextBlock Text="{v:L 'Séries', 'Shows'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,14,0,7"/><DockPanel><Button Content="{v:L 'Parcourir', 'Browse'}" DockPanel.Dock="Right" Margin="10,0,0,0" Tag="series" Click="BrowseTorLinkFolder_Click"/><TextBox x:Name="TorLinkSeriesBox" AutomationProperties.Name="{v:L 'Dossier des séries', 'Shows folder'}"/></DockPanel>
        <TextBlock Text="{v:L 'Animes', 'Anime'}" FontSize="12" Foreground="{StaticResource TextTertiary}" Margin="0,14,0,7"/><DockPanel><Button Content="{v:L 'Parcourir', 'Browse'}" DockPanel.Dock="Right" Margin="10,0,0,0" Tag="anime" Click="BrowseTorLinkFolder_Click"/><TextBox x:Name="TorLinkAnimeBox" AutomationProperties.Name="{v:L 'Dossier des animes', 'Anime folder'}"/></DockPanel>
       </StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="ReportSettings" Visibility="Collapsed"><Border Style="{StaticResource SettingRow}"><StackPanel><DockPanel><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="ReportPeriod" DockPanel.Dock="Right" Width="180" SelectedIndex="0" SelectionChanged="ReportPeriod_Changed" AutomationProperties.Name="{v:L 'Période du bilan', 'Recap period'}"><ComboBoxItem Content="{v:L 'Ce mois-ci', 'This month'}" Tag="month"/><ComboBoxItem Content="{v:L 'Cette année', 'This year'}" Tag="year"/></ComboBox><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ReportTime" FontSize="40" FontWeight="Bold"/><TextBlock x:Name="ReportCounts" Style="{StaticResource SettingDescription}" FontSize="14" Margin="0,4,0,0" v:Accessible.Announce="Polite"/></StackPanel></DockPanel><StackPanel x:Name="ReportBody" Margin="0,8,0,0"/><TextBlock Text="{v:L 'D’après Jellyfin : chaque film ou épisode vu jusqu’au bout compte une fois, à sa dernière lecture, sur tous tes appareils.', 'From Jellyfin: each movie or episode watched to the end counts once, at its last viewing, on all your devices.'}" Style="{StaticResource SettingDescription}" Margin="0,18,30,0"/></StackPanel></Border></StackPanel>
      <StackPanel x:Name="UpdateSettings" Visibility="Collapsed">
       <Border Style="{StaticResource SettingRow}"><StackPanel>
        <DockPanel><Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Content="{v:L 'Rechercher', 'Search'}" VerticalAlignment="Top" Click="CheckUpdates_Click" AutomationProperties.Name="{v:L 'Rechercher une mise à jour', 'Check for an update'}"/><StackPanel Margin="0,0,16,0"><TextBlock x:Name="UpdateVersionText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingDescription}" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel>
        <Border x:Name="UpdateProgressTrack" Height="3" Margin="0,16,0,0" Background="{StaticResource Line}" CornerRadius="1.5" ClipToBounds="True" Visibility="Collapsed"><Border Background="{StaticResource Accent}" CornerRadius="1.5" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="UpdateProgressScale" ScaleX="0"/></Border.RenderTransform></Border></Border>
        <WrapPanel x:Name="UpdateActions" Margin="0,18,0,0" Visibility="Collapsed"><Button x:Name="RestartUpdateButton" Style="{StaticResource Primary}" Content="{v:L 'Redémarrer et mettre à jour', 'Restart and update'}" Click="RestartToUpdate_Click" Margin="0,0,10,8"/><Button x:Name="UpdateNotesButton" Style="{StaticResource Quiet}" Content="{v:L 'Voir les nouveautés', 'See what’s new'}" Click="UpdateNotes_Click" Margin="0,0,0,8"/></WrapPanel>
       </StackPanel></Border>
       <Border Style="{StaticResource SettingRow}"><DockPanel><CheckBox x:Name="AutoUpdateCheck" DockPanel.Dock="Right" AutomationProperties.Name="{v:L 'Mettre à jour automatiquement', 'Update automatically'}"/><StackPanel><TextBlock Text="{v:L 'Mettre à jour automatiquement', 'Update automatically'}" FontWeight="SemiBold"/><TextBlock Text="{v:L 'Mira cherche une nouvelle version au démarrage puis toutes les 6 heures, la télécharge en arrière-plan et l’installe quand tu fermes l’application. Avant d’être installée, chaque version est vérifiée : signature de Mira, taille et empreinte SHA-256. Tes données restent en place.', 'Mira checks for a new version at startup and then every 6 hours, downloads it in the background and installs it when you close the app. Before it’s installed, each version is checked: Mira’s signature, size and SHA-256 fingerprint. Your data stays in place.'}" Style="{StaticResource SettingDescription}"/></StackPanel></DockPanel></Border>
       <TextBlock x:Name="UpdateInstallText" Style="{StaticResource SettingDescription}" Margin="0,13,30,0"/>
      </StackPanel>
     </StackPanel></ScrollViewer>
    </Grid>
    <DockPanel Grid.Row="2" Margin="241,14,8,0"><Button Content="{v:L 'Enregistrer', 'Save'}" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="SaveSettings_Click" MinWidth="126"/><TextBlock x:Name="SettingsSaveStatus" Text="{v:L 'Les changements s’appliquent après enregistrement.', 'Changes apply once saved.'}" v:Accessible.Announce="Polite" VerticalAlignment="Center" Foreground="{DynamicResource Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,15,0"/></DockPanel>
   </Grid>
  </Grid>
  <Grid x:Name="GuideOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource Bg}" KeyboardNavigation.TabNavigation="Cycle">
   <ScrollViewer x:Name="GuideScroll" Style="{StaticResource {x:Type ScrollViewer}}" v:SmoothScroll.Enabled="True" Margin="112,52,20,0" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="GuideContent" MaxWidth="1240" HorizontalAlignment="Left" Margin="0,0,10,40">
     <DockPanel Margin="0,0,14,0"><Button x:Name="GuideClose" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="CloseGuide_Click" ToolTip="{v:L 'Fermer le guide · Échap', 'Close the guide · Esc'}" AutomationProperties.Name="{v:L 'Fermer le guide', 'Close the guide'}"><v:Icon Kind="close" Width="17" Height="17"/></Button>
      <StackPanel><TextBlock Text="Guide" FontSize="31" FontWeight="SemiBold"/><TextBlock x:Name="GuideIntro" Text="{v:L 'L’essentiel pour bien démarrer.', 'The essentials to get started.'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,20,0"/></StackPanel></DockPanel>
     <Border Height="1" Background="{StaticResource Raised2}" Margin="0,20,14,20"/>
     <!-- Two columns on a wide window, one on a narrow one (MainWindow.Guide). -->
     <WrapPanel x:Name="GuideGrid" SizeChanged="GuideGrid_SizeChanged">
      <Border Style="{StaticResource SettingRow}" Padding="24,22" Margin="0,0,14,14"><DockPanel>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Raised}" VerticalAlignment="Top" Margin="0,0,18,0"><v:Icon Kind="folder" Width="20" Height="20" Foreground="{StaticResource Text}"/></Border>
       <StackPanel>
        <TextBlock Text="{v:L 'Ajouter tes vidéos', 'Add your videos'}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SettingDescription}" Margin="0,6,0,0" Text="{v:L 'Range tes fichiers dans ces dossiers : ils apparaissent dans Mira en quelques minutes, avec leurs affiches.', 'Put your files in these folders: they show up in Mira within a few minutes, with their posters.'}"/>
        <StackPanel x:Name="GuideFolders" Margin="0,12,0,0"/>
        <TextBlock x:Name="GuideFoldersHint" Style="{StaticResource SettingDescription}" Margin="0,2,0,0" Visibility="Collapsed"/>
        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="14,11" Margin="0,10,0,0"><TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="19"><Run Text="{v:L 'Noms reconnus', 'Names Jellyfin recognizes'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><LineBreak/><Run Text="{v:L 'Films\\Inception (2010)\\Inception (2010).mkv', 'Movies\\Inception (2010)\\Inception (2010).mkv'}" FontFamily="Consolas"/><LineBreak/><Run Text="{v:L 'Séries\\Dark\\Season 01\\Dark - S01E01.mkv', 'Shows\\Dark\\Season 01\\Dark - S01E01.mkv'}" FontFamily="Consolas"/></TextBlock></Border>
       </StackPanel></DockPanel></Border>
      <Border x:Name="GuidePhone" Style="{StaticResource SettingRow}" Padding="24,22" Margin="0,0,14,14"><DockPanel>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Raised}" VerticalAlignment="Top" Margin="0,0,18,0"><v:Icon Kind="phone" Width="20" Height="20" Foreground="{StaticResource Text}"/></Border>
       <StackPanel>
        <TextBlock Text="{v:L 'Mira sur ton téléphone', 'Mira on your phone'}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SettingDescription}" Margin="0,6,0,0" Text="{v:L 'iPhone, iPad ou Android : Mira s’ouvre comme une app, chez toi et ailleurs.', 'iPhone, iPad or Android: Mira opens like an app, at home and away.'}"/>
        <!-- What stands between Jellyfin and the phone, each step done or to do (MainWindow.Guide, PhoneSetup). -->
        <StackPanel x:Name="PhoneSteps" Margin="0,16,0,0"/>
        <WrapPanel x:Name="PhoneActions" Margin="0,4,0,0"><Button x:Name="PhoneMain" Style="{StaticResource Primary}" v:Motion.Radius="9" Padding="18,9" Margin="0,0,10,8" Click="PhoneMain_Click"/><Button x:Name="PhoneShare" Content="{v:L 'Afficher le QR code', 'Show the QR code'}" Style="{StaticResource Quiet}" Padding="13,6" Margin="0,0,10,8" VerticalAlignment="Center" Click="PhoneShare_Click"/></WrapPanel>
        <TextBlock x:Name="PhoneStatus" Style="{StaticResource SettingDescription}" Margin="0,2,0,0" v:Accessible.Announce="Polite"/>
        <WrapPanel x:Name="PhoneAddressLine" Margin="0,12,0,0"><TextBlock Text="{v:L 'Ou tape dans Safari ou Chrome :', 'Or type in Safari or Chrome:'}" FontSize="12" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="PhoneAddress" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="{v:L 'Copier', 'Copy'}" Style="{StaticResource Quiet}" Padding="11,5" Click="CopyPhoneAddress_Click"/></WrapPanel>
       </StackPanel></DockPanel></Border>
      <Border Style="{StaticResource SettingRow}" Padding="24,22" Margin="0,0,14,14"><DockPanel>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Raised}" VerticalAlignment="Top" Margin="0,0,18,0"><v:Icon Kind="globe" Width="20" Height="20" Foreground="{StaticResource Text}"/></Border>
       <StackPanel>
        <TextBlock Text="{v:L 'Gérer Jellyfin', 'Manage Jellyfin'}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SettingDescription}" Margin="0,6,0,0" Text="{v:L 'Bibliothèques, comptes, accès depuis Internet : tout se règle sur sa page web, dans le menu ☰ → Tableau de bord.', 'Libraries, accounts, access from the Internet: it’s all set on its web page, in the ☰ menu → Dashboard.'}"/>
        <WrapPanel x:Name="GuideJellyfinActions" Margin="0,14,0,0"><Button Content="{v:L 'Ouvrir Jellyfin', 'Open Jellyfin'}" Style="{StaticResource Primary}" v:Motion.Radius="9" Padding="18,9" Click="OpenJellyfin_Click" Margin="0,0,14,0"/><TextBlock x:Name="GuideServerAddress" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Faint}"/></WrapPanel>
        <!-- TVs and consoles have Jellyfin's own app: the address of this PC on the home network. -->
        <StackPanel x:Name="GuideRemote" Margin="0,18,0,0"><TextBlock Text="{v:L 'Sur une TV ou une console', 'On a TV or a console'}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource SettingDescription}" Margin="0,4,0,0" Text="{v:L 'Installe l’application Jellyfin, puis entre cette adresse :', 'Install the Jellyfin app, then enter this address:'}"/><WrapPanel Margin="0,8,0,0"><TextBlock x:Name="GuideRemoteAddress" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="GuideCopyAddress" Content="{v:L 'Copier', 'Copy'}" Style="{StaticResource Quiet}" Padding="13,6" Click="CopyRemoteAddress_Click"/></WrapPanel></StackPanel>
       </StackPanel></DockPanel></Border>
      <Border Style="{StaticResource SettingRow}" Padding="24,22" Margin="0,0,14,14"><DockPanel>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Raised}" VerticalAlignment="Top" Margin="0,0,18,0"><v:Icon Kind="play" Width="18" Height="18" Foreground="{StaticResource Text}"/></Border>
       <StackPanel>
        <TextBlock Text="{v:L 'Dans Mira', 'In Mira'}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SettingDescription}" Margin="0,6,0,0"><Run Text="Ctrl + K" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  chercher · ', '  search · '}"/><Run Text="{v:L 'Ctrl + 1 à 5', 'Ctrl + 1 to 5'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  pages du rail', '  sidebar pages'}"/><LineBreak/><Run Text="{v:L 'Espace', 'Space'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="  pause · "/><Run Text="← →" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L ' ou ', ' or '}"/><Run Text="J L" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  10 secondes · ', '  10 seconds · '}"/><Run Text="F" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  plein écran', '  full screen'}"/><LineBreak/><Run Text="S" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  passer le générique · ', '  skip the intro · '}"/><Run Text="I" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  mini-lecteur · ', '  mini player · '}"/><Run Text="N" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  épisode suivant', '  next episode'}"/><LineBreak/><Run Text="{v:L 'Roue dentée', 'Gear'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/><Run Text="{v:L '  langues, sous-titres, mises à jour', '  languages, subtitles, updates'}"/></TextBlock>
       </StackPanel></DockPanel></Border>
      <Border x:Name="GuideTorLink" Visibility="Collapsed" Style="{StaticResource SettingRow}" Padding="24,22" Margin="0,0,14,14"><DockPanel>
       <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="11" Background="{StaticResource Raised}" VerticalAlignment="Top" Margin="0,0,18,0"><v:Icon Kind="download" Width="20" Height="20" Foreground="{StaticResource Text}"/></Border>
       <StackPanel>
        <TextBlock Text="{v:L 'Téléchargements', 'Downloads'}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SettingDescription}" Margin="0,6,0,0" Text="{v:L 'Active TorLink dans la page Téléchargements : chaque téléchargement terminé rejoint Films, Séries ou Animes.', 'Turn on TorLink on the Downloads page: every finished download joins Movies, Shows or Anime.'}"/>
       </StackPanel></DockPanel></Border>
     </WrapPanel>
