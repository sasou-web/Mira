    <Border x:Name="PlayerMenu" Background="{StaticResource Menu}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,10" TextElement.FontFamily="{StaticResource AppFont}" TextElement.Foreground="{StaticResource Text}" KeyDown="PlayerOptions_KeyDown">
