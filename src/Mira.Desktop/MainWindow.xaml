      <StackPanel x:Name="HeroSynopsis" Width="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,46,85"><TextBlock x:Name="HeroOverview" Foreground="#C4C4C9" FontSize="13" LineHeight="21" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="85"/><WrapPanel x:Name="HeroGenrePills" Margin="0,16,0,0"/></StackPanel>
      <StackPanel x:Name="HeroDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="68,0,0,23"/>
     </Grid>
