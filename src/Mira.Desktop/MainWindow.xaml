      <TextBlock x:Name="PageTitle" Text="Explorer" FontSize="32" FontWeight="SemiBold"/>
      <TextBlock x:Name="CatalogDescription" Text="Toutes tes histoires, au même endroit." Foreground="{StaticResource Muted}" Margin="0,8,0,28"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition Width="0.75*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,16,0"><TextBlock Text="Titre" FontSize="13" Margin="1,0,0,9"/><Grid><TextBox x:Name="SearchBox" Height="44" Padding="39,12,40,12" TextChanged="Search_Changed" PreviewKeyDown="Search_KeyDown" AutomationProperties.Name="Rechercher dans la bibliothèque"/><v:Icon Kind="search" Width="17" Height="17" Foreground="#77777F" HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/><TextBlock x:Name="SearchPlaceholder" Text="Rechercher un titre…" Margin="39,0,0,0" VerticalAlignment="Center" Foreground="#77777F" IsHitTestVisible="False"/><Button x:Name="SearchClear" Style="{StaticResource IconButton}" Width="32" Height="32" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" Click="SearchClear_Click" ToolTip="Effacer · Échap" AutomationProperties.Name="Effacer la recherche"><v:Icon Kind="close" Width="14" Height="14" Foreground="#A2A2A8"/></Button></Grid></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Genre" FontSize="13" Margin="1,0,0,9"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="GenreFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="Genre"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="Année" FontSize="13" Margin="1,0,0,9"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="YearFilter" SelectionChanged="Filter_Changed" AutomationProperties.Name="Année"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="0,0,16,0"><TextBlock Text="Progression" FontSize="13" Margin="1,0,0,9"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="WatchedFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Progression"><ComboBoxItem Content="Tout" Tag="all"/><ComboBoxItem Content="Non vus" Tag="unplayed"/><ComboBoxItem Content="Déjà vus" Tag="played"/></ComboBox></StackPanel>
       <StackPanel Grid.Column="4"><TextBlock Text="Trier par" FontSize="13" Margin="1,0,0,9"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="SortFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Trier par"><ComboBoxItem Content="Ajout récent" Tag="recent"/><ComboBoxItem Content="Titre A → Z" Tag="title"/><ComboBoxItem Content="Année" Tag="year"/><ComboBoxItem Content="Note" Tag="rating"/><ComboBoxItem Content="Dernière lecture" Tag="played"/></ComboBox></StackPanel>
      </Grid>
      <DockPanel Margin="0,18,0,24"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="Refresh_Click" ToolTip="Jellyfin cherche les nouveaux fichiers dans tes dossiers, puis la liste se recharge" AutomationProperties.Name="Actualiser la bibliothèque"><StackPanel Orientation="Horizontal"><v:Icon x:Name="RefreshIcon" Kind="refresh" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock x:Name="RefreshLabel" Text="Actualiser"/></StackPanel></Button><Button x:Name="PersonFilter" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="PersonFilter_Click" Margin="0,0,12,0" Visibility="Collapsed" Background="#F4F4F5" Foreground="#151516" ToolTip="Retirer ce filtre" AutomationProperties.Name="Retirer le filtre de personne"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PersonFilterText" VerticalAlignment="Center"/><v:Icon Kind="close" Width="13" Height="13" Margin="10,0,0,0" Foreground="#151516"/></StackPanel></Button><Button x:Name="FavoritesFilter" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="Favorites_Click" Margin="0,0,12,0" ToolTip="Afficher seulement tes favoris" AutomationProperties.Name="Favoris seulement"><StackPanel Orientation="Horizontal"><v:Icon x:Name="FavoritesIcon" Kind="heart" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Favoris"/></StackPanel></Button><Button DockPanel.Dock="Right" Content="Réinitialiser" Style="{StaticResource Quiet}" Click="ResetFilters_Click" Margin="0,0,12,0"/><ComboBox PreviewMouseLeftButtonDown="Combo_PreviewClick" x:Name="LibraryFilter" Width="240" HorizontalAlignment="Left" SelectionChanged="LibraryFilter_Changed" AutomationProperties.Name="Bibliothèque"/></DockPanel>
     </StackPanel>
     <StackPanel x:Name="LibraryRows" Margin="110,0,40,42">
      <StackPanel x:Name="ResumeSection" Margin="0,0,0,30" Visibility="Collapsed">
       <DockPanel Margin="0,0,0,16"><StackPanel x:Name="ResumeArrows" DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" x:Name="ResumePreviousButton" Click="ResumePrevious_Click" ToolTip="Titres précédents" AutomationProperties.Name="Titres précédents"><v:Icon Kind="back" Width="17" Height="17"/></Button><Button Style="{StaticResource IconButton}" x:Name="ResumeNextButton" Click="ResumeNext_Click" ToolTip="Titres suivants" AutomationProperties.Name="Titres suivants"><v:Icon Kind="next" Width="17" Height="17"/></Button></StackPanel><TextBlock Text="Continuer à regarder" FontSize="24" FontWeight="Normal" Foreground="#B7B7BC" VerticalAlignment="Center"/></DockPanel>
       <ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" x:Name="ResumeScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ><StackPanel x:Name="ResumeCards" Orientation="Horizontal"/></ScrollViewer>
      </StackPanel>
      <StackPanel x:Name="NextUpSection" Visibility="Collapsed" Margin="0,0,0,33"><TextBlock Text="Le prochain épisode t’attend" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/><ScrollViewer Style="{StaticResource {x:Type ScrollViewer}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ><StackPanel x:Name="NextUpCards" Orientation="Horizontal"/></ScrollViewer></StackPanel>
      <DockPanel Margin="0,0,6,22"><TextBlock x:Name="ItemCount" DockPanel.Dock="Right" VerticalAlignment="Bottom" Foreground="#898990" FontSize="12"/><TextBlock x:Name="GridTitle" Text="Ajoutés récemment" FontSize="24" FontWeight="Normal" Foreground="#B7B7BC"/></DockPanel>
      <WrapPanel x:Name="CatalogSkeleton" Visibility="Collapsed" IsHitTestVisible="False"/><WrapPanel x:Name="PosterCards" Margin="0,0,-22,0" SizeChanged="PosterGrid_SizeChanged"/>
      <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,70,0,80" HorizontalAlignment="Center"><v:Icon x:Name="EmptyIcon" Kind="library" Width="42" Height="42" Foreground="#67676F" Margin="0,0,0,17"/><TextBlock x:Name="EmptyTitle" Text="Aucun titre à afficher" FontSize="22" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Essaie une autre recherche ou retire un filtre." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Margin="0,10,0,0"/><Button x:Name="EmptyReset" Content="Réinitialiser les filtres" Style="{StaticResource Quiet}" HorizontalAlignment="Center" Margin="0,16,0,0" Click="ResetFilters_Click" Visibility="Collapsed"/><Button x:Name="EmptyGuide" Content="Où mettre mes vidéos ?" Style="{StaticResource Primary}" v:Motion.Radius="9" Padding="20,10" HorizontalAlignment="Center" Margin="0,20,0,0" Click="Guide_Click" Visibility="Collapsed"/></StackPanel>
      <Button x:Name="LoadMore" Content="Afficher plus de titres" HorizontalAlignment="Center" Click="LoadMore_Click" Margin="0,15,0,20" Visibility="Collapsed"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <!-- Mini-player backdrop: rounded shape and soft shadow behind the native video surface. -->
  <Border x:Name="MiniFrame" Grid.RowSpan="2" Panel.ZIndex="29" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black" CornerRadius="12" IsHitTestVisible="False">
   <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.62" Color="Black" RenderingBias="Performance"/></Border.Effect>
  </Border>
  <Grid x:Name="PlayerShell" Grid.RowSpan="2" Visibility="Collapsed" Background="Black" Panel.ZIndex="30" SizeChanged="Player_SizeChanged" MouseMove="MiniDrag_MouseMove" MouseLeftButtonUp="MiniDrag_MouseUp" LostMouseCapture="MiniDrag_LostCapture">
   <Grid x:Name="VideoContainer" Background="Black"/>
   <playback:PlayerOverlay x:Name="PlayerOverlayLayer" PlacementTarget="{Binding ElementName=PlayerShell}">
    <!-- The decorator gives the separate overlay window an adorner layer for keyboard focus rings. -->
    <AdornerDecorator>
    <Grid x:Name="PlayerSurface" Background="#01000000" Focusable="True" FocusVisualStyle="{x:Null}" ClipToBounds="True" Cursor="Arrow" TextElement.FontFamily="{StaticResource AppFont}" MouseMove="PlayerSurface_MouseMove" MouseLeave="PlayerSurface_MouseLeave" MouseLeftButtonDown="PlayerSurface_MouseDown" MouseLeftButtonUp="PlayerSurface_MouseUp" PreviewKeyDown="Player_PreviewKeyDown" KeyDown="Window_KeyDown">
    <!-- Top: back to the library, or the mini-player's title and buttons. The title of a full player sits in the bottom bar.
         The shades never take clicks: a click on the video, even under them, pauses as anywhere else. -->
    <Grid x:Name="PlayerHeader" Height="108" VerticalAlignment="Top">
     <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A6000000"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <DockPanel x:Name="PlayerHeaderBody" Margin="24,42,24,22" VerticalAlignment="Top">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="MiniExpandButton" Visibility="Collapsed" Style="{StaticResource PlayerButton}" Width="32" Height="32" v:Motion.Radius="16" Click="ExpandPlayer_Click" ToolTip="Agrandir le lecteur · I" AutomationProperties.Name="Agrandir le lecteur"><v:Icon Kind="expand" Width="17" Height="17"/></Button><Button x:Name="MiniCloseButton" Visibility="Collapsed" Style="{StaticResource PlayerButton}" Width="32" Height="32" v:Motion.Radius="16" Margin="2,0,0,0" Click="StopPlayer_Click" ToolTip="Fermer le mini-lecteur" AutomationProperties.Name="Fermer le mini-lecteur"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel>
      <Button x:Name="PlayerBackButton" DockPanel.Dock="Left" Style="{StaticResource PlayerButton}" Click="MiniPlayer_Click" ToolTip="Revenir à la bibliothèque · Échap" AutomationProperties.Name="Revenir à la bibliothèque"><v:Icon Kind="down"/></Button>
      <TextBlock x:Name="MiniTitle" Visibility="Collapsed" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="2,0,10,0" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Grid>
    <!-- Bottom bar: title and episode on the left, chapter and time on the right, the timeline split by chapters,
         then play, next episode and volume on the left, the menus, mini-player and fullscreen on the right. -->
    <Grid x:Name="PlayerControls" Height="210" VerticalAlignment="Bottom">
     <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000"/><GradientStop Color="#8C000000" Offset="0.5"/><GradientStop Color="#EB000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Grid x:Name="PlayerControlsBody" Margin="24,0,24,14" VerticalAlignment="Bottom"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="PlayerInfo" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Bottom" Margin="0,0,32,0"><TextBlock x:Name="PlayingTitle" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PlayingSubtitle" Foreground="#A9A9B1" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Bottom"><TextBlock x:Name="ChapterText" Visibility="Collapsed" Foreground="#A9A9B1" FontSize="12" HorizontalAlignment="Right" MaxWidth="300" TextTrimming="CharacterEllipsis"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,2,0,0" TextElement.FontSize="13" Typography.NumeralAlignment="Tabular"><TextBlock x:Name="PositionText" Text="0:00" Foreground="#F2F2F4"/><TextBlock x:Name="TimeDivider" Text=" / " Foreground="#8E8E96"/><TextBlock x:Name="DurationText" Text="0:00" Foreground="#C4C4CB"/></StackPanel></StackPanel>
      </Grid>
      <v:Timeline x:Name="SeekBar" Grid.Row="1" Height="24" IsEnabled="False" AutomationProperties.Name="Position de lecture"/>
      <!-- The row overhangs the margins by the buttons' own padding, so the glyphs line up with the text above. -->
      <Grid x:Name="PlayerTransport" Grid.Row="2" Margin="-8,2,-8,0" Height="44"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel x:Name="PlayerLeftGroup" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PauseButton" Style="{StaticResource PlayerBarButton}" Click="Pause_Click" ToolTip="Pause · Espace" AutomationProperties.Name="Pause"><v:Icon x:Name="PauseIcon" Kind="pause" Width="24" Height="24"/></Button><Button x:Name="NextButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Next_Click" ToolTip="Épisode suivant" AutomationProperties.Name="Épisode suivant"><v:Icon Kind="next-episode"/></Button>
        <!-- The volume slider slides out of the speaker while the pointer is on it, as on streaming players. -->
        <StackPanel x:Name="PlayerVolumeGroup" Orientation="Horizontal" Margin="6,0,0,0" Background="Transparent" MouseEnter="VolumeGroup_MouseEnter" MouseLeave="VolumeGroup_MouseLeave" PreviewMouseWheel="VolumeGroup_MouseWheel"><Button x:Name="MuteButton" Style="{StaticResource PlayerBarButton}" Click="Mute_Click" GotKeyboardFocus="VolumeGroup_FocusChanged" LostKeyboardFocus="VolumeGroup_FocusChanged" ToolTip="Couper le son · M" AutomationProperties.Name="Couper le son"><v:Icon x:Name="VolumeIcon" Kind="volume"/></Button><Border x:Name="VolumeReveal" Width="0" ClipToBounds="True" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><!-- 100 % sits at the middle, marked under the track; to the right, the sound is raised without clipping. --><Grid Width="112" Margin="6,0,8,0"><Border Width="2" Height="10" CornerRadius="1" Background="#77777D" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" SmallChange="5" LargeChange="5" Focusable="False" ValueChanged="Volume_Changed" LostMouseCapture="VolumeSlider_LostMouseCapture" ToolTip="Au-delà de 100 %, le son est amplifié sans saturer" AutomationProperties.Name="Volume"/></Grid><TextBlock x:Name="VolumeText" Width="40" Margin="0,0,8,0" FontSize="12" Foreground="#A9A9B1" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/></StackPanel></Border></StackPanel></StackPanel>
       <StackPanel x:Name="PlayerRightGroup" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PlayerMoreButton" Style="{StaticResource PlayerBarButton}" Click="More_Click" ToolTip="Vitesse, décalage des sous-titres et informations" AutomationProperties.Name="Plus d’options"><v:Icon Kind="more"/></Button><Button x:Name="PlayerTracksButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Tracks_Click" ToolTip="Audio et sous-titres" AutomationProperties.Name="Audio et sous-titres"><v:Icon Kind="subtitles"/></Button><Button x:Name="MiniPlayerButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="MiniPlayer_Click" ToolTip="Mini-lecteur · I" AutomationProperties.Name="Mini-lecteur"><v:Icon Kind="mini"/></Button><Button x:Name="FullscreenButton" Style="{StaticResource PlayerBarButton}" Margin="6,0,0,0" Click="Fullscreen_Click" ToolTip="Plein écran · F" AutomationProperties.Name="Plein écran"><v:Icon x:Name="FullscreenIcon" Kind="fullscreen"/></Button></StackPanel>
      </Grid>
     </Grid>
    </Grid>
    <!-- Shown until mpv displays the first frame, so opening a stream never looks frozen. -->
    <Grid x:Name="PlayerLoading" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.Name="Chargement de la vidéo">
     <Ellipse Stroke="#33FFFFFF" StrokeThickness="3"/>
     <Path Stroke="#F5F5F7" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 23,1.5 A 21.5,21.5 0 0 1 44.5,23" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform x:Name="LoadingSpin"/></Path.RenderTransform></Path>
    </Grid>
    <!-- Skip opening / ending / next episode, bottom right. Lifted above the controls while they are shown. -->
    <StackPanel x:Name="SkipHost" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,32">
     <StackPanel.RenderTransform><TranslateTransform x:Name="SkipShift"/></StackPanel.RenderTransform>
     <Button x:Name="SkipCancel" Style="{StaticResource PlayerPill}" Padding="16,12" Margin="0,0,10,0" Visibility="Collapsed" Click="SkipCancel_Click" ToolTip="Rester sur cet épisode" AutomationProperties.Name="Annuler l’épisode suivant automatique"><TextBlock Text="Annuler"/></Button>
     <Button x:Name="SkipButton" Style="{StaticResource PlayerPill}" Visibility="Collapsed" Click="Skip_Click" AutomationProperties.Name="Passer le passage"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SkipText" Text="Passer l’opening" VerticalAlignment="Center"/><v:Icon Kind="skip" Width="16" Height="16" Margin="11,0,0,0"/></StackPanel></Button>
    </StackPanel>
    <Border x:Name="MiniOutline" Visibility="Collapsed" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False"/>
    <Grid x:Name="PlayerWindowChrome" Height="34" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="PlayerChrome_MouseDown">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Minimize_Click" ToolTip="Réduire la fenêtre" AutomationProperties.Name="Réduire la fenêtre"><v:Icon Kind="minus" Width="16" Height="16"/></Button><Button x:Name="PlayerMaximizeButton" Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Maximize_Click" ToolTip="Agrandir la fenêtre" AutomationProperties.Name="Agrandir la fenêtre"><v:Icon x:Name="PlayerMaximizeIcon" Kind="maximize" Width="15" Height="15"/></Button><Button Width="46" Height="32" Padding="0" Style="{StaticResource Quiet}" Click="Close_Click" ToolTip="Fermer Mira" AutomationProperties.Name="Fermer Mira"><v:Icon Kind="close" Width="17" Height="17"/></Button></StackPanel>
    </Grid>
    </Grid>
    </AdornerDecorator>
   </playback:PlayerOverlay>
   <Popup x:Name="PlayerOptionsPopup" PlacementTarget="{Binding ElementName=PlayerShell}" Placement="Custom" AllowsTransparency="True" StaysOpen="False" Opened="PlayerOptions_Opened" Closed="PlayerOptions_Closed">
    <!-- One menu window, opened above the button that asked for it: audio and subtitles, or the ⋮ options. -->
    <Border x:Name="PlayerMenu" Background="#F5141417" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,10" TextElement.FontFamily="{StaticResource AppFont}" TextElement.Foreground="#F5F5F7" KeyDown="PlayerOptions_KeyDown">
     <Grid>
      <Grid x:Name="TracksMenu"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel MinWidth="196" MaxWidth="270" Margin="0,0,4,0"><TextBlock Text="AUDIO" Style="{StaticResource PlayerMenuHeading}"/><ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AudioTrackList" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></StackPanel>
       <StackPanel Grid.Column="1" MinWidth="196" MaxWidth="270"><TextBlock Text="SOUS-TITRES" Style="{StaticResource PlayerMenuHeading}"/><ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SubtitleTrackList" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer><Border Height="1" Background="#24FFFFFF" Margin="10,5"/><Button Style="{StaticResource PlayerMenuItem}" Click="LoadSubtitle_Click" AutomationProperties.Name="Charger un fichier de sous-titres"><DockPanel><v:Icon Kind="plus" Width="15" Height="15" Margin="1,0,11,0" Foreground="#D9D9DE"/><TextBlock Text="Charger un fichier…" VerticalAlignment="Center"/></DockPanel></Button></StackPanel>
      </Grid>
      <StackPanel x:Name="MoreMenu" Width="300" Visibility="Collapsed">
       <TextBlock Text="VITESSE" Style="{StaticResource PlayerMenuHeading}"/>
