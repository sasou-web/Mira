    <!-- Shown until mpv displays the first frame, so opening a stream never looks frozen. -->
    <Grid x:Name="PlayerLoading" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.Name="{v:L 'Chargement de la vidéo', 'Loading the video'}">
